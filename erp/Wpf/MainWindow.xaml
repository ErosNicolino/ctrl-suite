<Window x:Class="GraficaCaixa.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GraficaCaixa.Wpf" Title="Ctrl A Ctrl P • Gestão da Gráfica" MinWidth="960" MinHeight="620" WindowState="Maximized" Icon="/Assets/icon.ico">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="14,10,14,8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Image x:Name="BrandLogo" Source="{DynamicResource Logo}" Height="58" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6" RenderOptions.BitmapScalingMode="HighQuality"/>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="NavList">
    <TextBlock Text="OPERAÇÃO" Style="{StaticResource Eyebrow}" Margin="10,2,0,4"/>
    <Button x:Name="NavHome" Style="{StaticResource NavCurrentButton}" Click="Home_Click" ToolTip="Início (Esc volta para cá; F1 mostra os atalhos)"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:UiIcon IconName="house" Width="19" Height="19" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/><TextBlock Text="Início" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Button>
    <Button x:Name="NavOrders" Style="{StaticResource NavButton}" Click="ScheduledOrders_Click" ToolTip="Pedidos e produção (F4)"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:UiIcon IconName="clipboard-list" Width="19" Height="19" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/><TextBlock Text="Pedidos e produção" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Button>
    <Button x:Name="NavBudget" Style="{StaticResource NavButton}" Click="Budget_Click"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:UiIcon IconName="file-text" Width="19" Height="19" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/><TextBlock Text="Orçamentos" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Button>
    <Button x:Name="NavPurchases" Style="{StaticResource NavButton}" Click="PurchaseNeeds_Click"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:UiIcon IconName="shopping-cart" Width="19" Height="19" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/><TextBlock Text="Compras" VerticalAlignment="Center" Margin="8,0,0,0"/><Border x:Name="PurchasesBadge" Background="{DynamicResource Warning}" CornerRadius="9" Padding="5,0" Margin="7,0,0,0" Visibility="Collapsed"><TextBlock x:Name="PurchasesCount" Foreground="White" FontSize="11" FontWeight="Bold"/></Border></StackPanel></Button>
    <Button x:Name="NavSuppliers" Style="{StaticResource NavButton}" Click="Suppliers_Click"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:UiIcon IconName="truck" Width="19" Height="19" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/><TextBlock Text="Fornecedores" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Button>
    <Button x:Name="NavProducts" Style="{StaticResource NavButton}" Click="Products_Click"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:UiIcon IconName="package" Width="19" Height="19" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/><TextBlock Text="Produtos" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Button>
    <Button x:Name="NavCustomers" Style="{StaticResource NavButton}" Click="Customers_Click"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:UiIcon IconName="users" Width="19" Height="19" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/><TextBlock Text="Clientes" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Button>
    <Button x:Name="NavReminders" Style="{StaticResource NavButton}" Click="Reminders_Click" ToolTip="Pessoas para verificar depois no WhatsApp"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><local:UiIcon IconName="message-circle" Width="19" Height="19" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/><TextBlock Grid.Column="1" Text="Lembretes" VerticalAlignment="Center" Margin="8,0,0,0"/><Border x:Name="RemindersBadge" Grid.Column="2" Visibility="Collapsed" Background="{DynamicResource Warning}" CornerRadius="9" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="RemindersCount" Foreground="White" FontSize="11" FontWeight="SemiBold"/></Border></Grid></Button>
      <TextBlock Text="CAIXA E FINANCEIRO" Style="{StaticResource Eyebrow}" Margin="10,8,0,4"/>
    <StackPanel Margin="0,0,0,4"><Button x:Name="OpenButton" Content="Abrir caixa" Style="{StaticResource PrimaryButton}" Click="Open_Click"/><Button x:Name="CloseButton" Content="Fechar caixa" Style="{StaticResource SoftButton}" Click="Close_Click" Visibility="Collapsed"/></StackPanel>
    <Button Style="{StaticResource NavButton}" Click="Withdrawal_Click"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:UiIcon IconName="banknote" Width="19" Height="19" VerticalAlignment="Center" Foreground="{DynamicResource CInfo}"/><TextBlock Text="Sangria do caixa" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Button>
    <Button Style="{StaticResource NavButton}" Click="Receipt_Click" ToolTip="Recibo em PDF com CNPJ/CPF do cliente e carimbo"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:UiIcon IconName="file-text" Width="19" Height="19" VerticalAlignment="Center" Foreground="{DynamicResource CInfo}"/><TextBlock Text="Recibo avulso" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Button>
    <Button x:Name="NavDebtors" Style="{StaticResource NavButton}" Click="Debtors_Click"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:UiIcon IconName="wallet" Width="19" Height="19" VerticalAlignment="Center" Foreground="{DynamicResource CInfo}"/><TextBlock Text="Devedores" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Button>
    <Button x:Name="NavClosed" Style="{StaticResource NavButton}" Click="ClosedSessions_Click"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:UiIcon IconName="archive" Width="19" Height="19" VerticalAlignment="Center" Foreground="{DynamicResource CInfo}"/><TextBlock Text="Fechamentos" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Button>
    <Button x:Name="NavSearch" Style="{StaticResource NavButton}" Click="Search_Click" ToolTip="Pesquisar lançamentos (F3)"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:UiIcon IconName="search" Width="19" Height="19" VerticalAlignment="Center" Foreground="{DynamicResource CInfo}"/><TextBlock Text="Pesquisar lançamentos" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Button>
    <Button x:Name="NavReports" Style="{StaticResource NavButton}" Click="Reports_Click"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:UiIcon IconName="chart-no-axes-combined" Width="19" Height="19" VerticalAlignment="Center" Foreground="{DynamicResource CInfo}"/><TextBlock Text="Relatórios financeiros" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Button>
   </StackPanel></ScrollViewer>
   <StackPanel Grid.Row="2"><Separator Background="{DynamicResource Line}" Margin="0,6,0,6"/>
    <Button x:Name="NavSystem" Style="{StaticResource NavButton}" Click="System_Click" ToolTip="Configurações, usuários, segurança, backups e aparência"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:UiIcon IconName="settings" Width="19" Height="19" VerticalAlignment="Center" Foreground="{DynamicResource CViolet}"/><TextBlock Text="Sistema" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Button>
    <TextBlock x:Name="EnvironmentText" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="10,6,4,0" ToolTip="Dados protegidos: backup automático a cada alteração"/>
   </StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <Border x:Name="TopBar" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="18,8,14,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="CommandButton" Style="{StaticResource CommandBarButton}" MaxWidth="440" HorizontalAlignment="Left" Margin="0,0,16,0" Click="CommandPalette_Click" ToolTip="Ir para telas, configurações e ações (Ctrl+K)"><DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource Kbd}" VerticalAlignment="Center"><TextBlock Text="Ctrl K"/></Border><local:UiIcon IconName="search" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><TextBlock Text="Buscar telas, configurações e ações…" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></Button>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button x:Name="CashChip" Style="{StaticResource TopChip}" Click="CashChip_Click" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="CashChipDot" Width="9" Height="9" Fill="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock x:Name="CashChipText" Text="Caixa" VerticalAlignment="Center"/></StackPanel></Button>
    <Button x:Name="NewMenuButton" Content="Novo ▾" Style="{StaticResource PrimaryButton}" Click="NewMenu_Click" Margin="0,0,8,0" ToolTip="Novo lançamento (L), novo pedido (N) e cadastros"/>
    <Button x:Name="UserChip" Style="{StaticResource TopChip}" Click="UserChip_Click" AutomationProperties.Name="Menu do usuário: trocar senha, aparência e sair" ToolTip="Usuário, aparência e sair" Padding="4,0,12,0"><StackPanel Orientation="Horizontal"><Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource AccentSoft}" Margin="0,0,8,0"><TextBlock x:Name="UserInitials" Foreground="{DynamicResource AccentInk}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="UserNameText" VerticalAlignment="Center" FontWeight="SemiBold"/><local:UiIcon IconName="chevron-down" Width="14" Height="14" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/></StackPanel></Button>
   </StackPanel>
  </Grid></Border>
  <Border x:Name="PageArea" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource Paper}"><ContentControl x:Name="PageHost" Focusable="False" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></Border>
  <Grid x:Name="DashboardView" Grid.Row="1" Margin="18,12,18,6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock x:Name="GreetingText" Text="Início" Style="{StaticResource Title}"/><WrapPanel Margin="0,3,0,0"><TextBlock x:Name="ClockText" Foreground="{DynamicResource Muted}" FontSize="12.5"/><TextBlock Text="  ·  " Foreground="{DynamicResource Muted}" FontSize="12.5"/><TextBlock x:Name="DashboardSubtitle" Text="Movimento do caixa e pedidos que precisam de atenção" Foreground="{DynamicResource Muted}" FontSize="12.5"/></WrapPanel></StackPanel>
    <!-- Um só botão principal por área: o "Novo ▾" do topo. Aqui ficam atalhos secundários com a tecla à mostra. -->
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button Style="{StaticResource PrimaryButton}" Click="Add_Click" ToolTip="Novo lançamento: venda paga na hora (atalhos L ou F2)" AutomationProperties.Name="Novo lançamento" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><local:UiIcon IconName="plus" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Novo lançamento" VerticalAlignment="Center"/><Border Style="{StaticResource Kbd}" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="F2"/></Border></StackPanel></Button><Button Style="{StaticResource SoftButton}" Click="NewOrderButton_Click" ToolTip="Novo pedido: produção com prazo, sinal e saldo (atalho N)" AutomationProperties.Name="Novo pedido"><StackPanel Orientation="Horizontal"><local:UiIcon IconName="plus" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Novo pedido" VerticalAlignment="Center"/><Border Style="{StaticResource Kbd}" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="N"/></Border></StackPanel></Button></StackPanel>
    <StackPanel Grid.Row="1" Grid.ColumnSpan="2"><Border x:Name="CertificateBox" Visibility="Collapsed" HorizontalAlignment="Left" MaxWidth="980" Margin="0,8,0,0" Padding="12,6,12,6" CornerRadius="10" Background="{DynamicResource WarningSoft}"><DockPanel><local:UiIcon IconName="triangle-alert" Width="17" Height="17" Foreground="{DynamicResource Warning}" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock VerticalAlignment="Center" TextWrapping="Wrap"><Run x:Name="CertificateTitle" FontWeight="SemiBold"/><Run Text="   "/><Run Text="O ERP tenta renovar sozinho. Se o aviso continuar, execute Renovar_Certificado_Celular.cmd (na pasta do último pacote)."/></TextBlock></DockPanel></Border><Border x:Name="PhraseBox" HorizontalAlignment="Left" MaxWidth="980" Margin="0,8,0,0" Padding="12,5,6,5" CornerRadius="10" Background="{DynamicResource SurfaceAlt}"><DockPanel><local:UiIcon IconName="sun" Width="17" Height="17" Foreground="{DynamicResource Warning}" VerticalAlignment="Center" Margin="0,0,10,0"/><Button DockPanel.Dock="Right" Style="{StaticResource IconButtonSmall}" Tag="x" ToolTip="Ocultar a frase do dia (para voltar: Sistema › Aparência)" Click="HidePhrase_Click" Margin="10,0,0,0"/><TextBlock VerticalAlignment="Center" TextWrapping="Wrap"><Run Text="Frase do dia" FontWeight="SemiBold"/><Run Text="   "/><Run x:Name="PhraseText"/></TextBlock></DockPanel></Border><Border x:Name="SeasonBox" Visibility="Collapsed" HorizontalAlignment="Left" MaxWidth="980" Margin="0,8,0,0" Padding="12,5,6,5" CornerRadius="10" Background="{DynamicResource AccentSoft}"><DockPanel><local:UiIcon IconName="calendar-days" Width="17" Height="17" Foreground="{DynamicResource AccentInk}" VerticalAlignment="Center" Margin="0,0,10,0"/><Button DockPanel.Dock="Right" Style="{StaticResource IconButtonSmall}" Tag="x" ToolTip="Ocultar este aviso (volta na próxima data)" Click="HideSeason_Click" Margin="6,0,0,0"/><Button DockPanel.Dock="Right" Content="Ver sugestões" Style="{StaticResource SoftButton}" Padding="12,3" MinHeight="28" Click="Season_Click" Margin="10,0,0,0" ToolTip="Mais vendidos e clientes da mesma época do ano passado; avisar pelo WhatsApp"/><TextBlock VerticalAlignment="Center" TextWrapping="Wrap"><Run x:Name="SeasonTitle" FontWeight="SemiBold"/><Run Text="   "/><Run x:Name="SeasonText"/></TextBlock></DockPanel></Border></StackPanel>
   </Grid>
   <Grid x:Name="KpiRow" Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="1.9*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.Resources>
     <!-- Faixa de cor que acompanha o canto do cartão (o mesmo desenho do KpiCap/KpiCard das outras telas). -->
     <Style x:Key="HomeKpiCap" TargetType="Border"><Setter Property="Height" Value="16"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="CornerRadius" Value="12,12,0,0"/><Setter Property="IsHitTestVisible" Value="False"/></Style>
     <Style x:Key="HomeKpiTile" TargetType="Border" BasedOn="{StaticResource KpiTile}"><Setter Property="Margin" Value="0,4,0,0"/><Setter Property="Padding" Value="16,10,16,9"/></Style>
     <!-- Cartão clicável: botão sem aparência própria, com foco visível pelo teclado (Enter ou espaço abre). -->
     <Style x:Key="HomeKpiButton" TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style>
    </Grid.Resources>
    <Grid><Border Style="{StaticResource HomeKpiCap}" Background="{DynamicResource COk}"/><Border Style="{StaticResource HomeKpiTile}"><StackPanel>
     <TextBlock x:Name="SalesLabel" Text="Recebimentos do caixa" Style="{StaticResource KpiLabel}"/><DockPanel Margin="0,2,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,5"><TextBlock x:Name="CountText" Text="0" FontSize="12.5" FontWeight="SemiBold"/><TextBlock Text=" lançamentos" FontSize="12.5" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="CountHint" Text="no caixa atual" Visibility="Collapsed"/></StackPanel><Grid><TextBlock x:Name="SalesText" Text="" FontSize="26" FontWeight="SemiBold"/><local:Skeleton x:Name="SalesSkeleton" Height="30" Width="170" HorizontalAlignment="Left"/></Grid></DockPanel>
     <Border CornerRadius="3" Background="{DynamicResource SurfaceAlt}" Height="6" Margin="0,4,0,0" ClipToBounds="True"><Grid x:Name="PaymentMix"/></Border>
     <WrapPanel x:Name="PaymentLegend" Margin="0,5,0,-4"/><TextBlock x:Name="PaymentBreakdownText" Visibility="Collapsed"/>
    </StackPanel></Border></Grid>
    <Button Grid.Column="2" Style="{StaticResource HomeKpiButton}" Click="CashKpi_Click" ToolTip="Conferir e fechar o caixa" AutomationProperties.Name="Dinheiro esperado na gaveta: conferir e fechar o caixa"><Grid><Border Style="{StaticResource HomeKpiCap}" Background="{DynamicResource CInfo}"/><Border Style="{StaticResource HomeKpiTile}"><StackPanel><TextBlock x:Name="CashLabel" Text="Dinheiro esperado" Style="{StaticResource KpiLabel}"/><Grid Margin="0,4,0,0"><TextBlock x:Name="CashText" Text="" FontSize="23" FontWeight="SemiBold"/><local:Skeleton x:Name="CashSkeleton" Height="26" Width="130" HorizontalAlignment="Left"/></Grid><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock x:Name="OpeningLabel" Text="Fundo inicial" FontSize="12.5" Foreground="{DynamicResource Muted}"/><TextBlock Text=": " FontSize="12.5" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="OpeningText" Text="R$ 0,00" FontSize="12.5" Foreground="{DynamicResource Muted}"/></StackPanel></StackPanel></Border></Grid></Button>
    <Button Grid.Column="4" Style="{StaticResource HomeKpiButton}" Click="AttentionKpi_Click" ToolTip="Abrir Pedidos só com as prioridades" AutomationProperties.Name="Pedidos que pedem atenção: abrir as prioridades"><Grid><Border x:Name="AttentionStripe" Style="{StaticResource HomeKpiCap}" Background="{DynamicResource CWarn}"/><Border Style="{StaticResource HomeKpiTile}"><StackPanel><TextBlock Text="Pedidos em atenção ›" Style="{StaticResource KpiLabel}"/><TextBlock x:Name="AttentionText" Text="—" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock x:Name="AttentionHint" Text="atrasados e que vencem em até 3 dias úteis" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border></Grid></Button>
    <Button Grid.Column="6" Style="{StaticResource HomeKpiButton}" Click="ReadyKpi_Click" ToolTip="Abrir Pedidos só com os prontos para retirada" AutomationProperties.Name="Prontos para retirada: abrir a lista"><Grid><Border Style="{StaticResource HomeKpiCap}" Background="{DynamicResource CViolet}"/><Border Style="{StaticResource HomeKpiTile}"><StackPanel><TextBlock Text="Prontos para retirada ›" Style="{StaticResource KpiLabel}"/><TextBlock x:Name="ReadyText" Text="—" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="aguardando o cliente buscar" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border></Grid></Button>
   </Grid>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="14"/><ColumnDefinition Width=".9*"/></Grid.ColumnDefinitions>
    <Border x:Name="SalesPanel" Grid.Column="0" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <Grid Margin="16,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Lançamentos" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/><Border x:Name="StatusPill" Background="{DynamicResource SurfaceAlt}" CornerRadius="8" Padding="10,5" Margin="12,0,0,0"><TextBlock x:Name="StatusText" Text="Caixa fechado" FontSize="11" Foreground="{DynamicResource Muted}"/></Border></StackPanel><WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"><Button Content="Histórico" Style="{StaticResource SoftButton}" Margin="0,0,8,0" Click="HistorySale_Click" ToolTip="Quem registrou ou alterou o lançamento selecionado"/><Button x:Name="ReceiptSaleButton" Content="Recibo" Style="{StaticResource SoftButton}" Click="SaleReceipt_Click" IsEnabled="False" Margin="0,0,8,0" ToolTip="Recibo em PDF com CNPJ do cliente e carimbo"/><Button x:Name="OrderSaleButton" Content="Virar pedido" Style="{StaticResource SoftButton}" Click="SaleToOrder_Click" IsEnabled="False" Margin="0,0,8,0" ToolTip="Cria o pedido com este lançamento como pagamento já recebido (não lança de novo no caixa)"/><Button x:Name="RefundSaleButton" Content="Devolver" Style="{StaticResource SoftButton}" Click="Refund_Click" IsEnabled="False" Margin="0,0,8,0" ToolTip="Devolver parte ou todo o valor ao cliente, em Dinheiro ou Pix (o pagamento original é preservado)"/><Button x:Name="EditSaleButton" Content="Editar" Style="{StaticResource SoftButton}" Click="Edit_Click" IsEnabled="False" ToolTip="Ou dê dois cliques no lançamento"/><Button x:Name="RemoveSaleButton" Content="Cancelar" ToolTip="O original é preservado e recebe um ajuste de cancelamento (tecla Delete)" Style="{StaticResource DangerCompactButton}" Margin="8,0,0,0" Click="Remove_Click" IsEnabled="False"/></WrapPanel><Grid Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBox x:Name="SalesSearchBox" Height="34" ToolTip="Pesquisar cliente, produto ou pagamento (Ctrl+F)" TextChanged="DashboardSearch_TextChanged"/><Border Style="{StaticResource Kbd}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"><TextBlock Text="Ctrl F"/></Border><TextBlock Text="Pesquisar cliente, produto…" Foreground="{DynamicResource Muted}" Margin="12,0,56,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SalesSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Grid>
     <Grid Grid.Row="1"><DataGrid x:Name="SalesGrid" SelectionChanged="SalesGrid_SelectionChanged" MouseDoubleClick="SalesGrid_DoubleClick" RowHeight="38" ColumnHeaderHeight="32" ScrollViewer.CanContentScroll="False"><DataGrid.Resources><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="MinHeight" Value="38"/></Style><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border x:Name="CellBorder" Background="{TemplateBinding Background}"><ContentPresenter Margin="10,0" VerticalAlignment="Center" HorizontalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="CellBorder" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style><Style x:Key="WrapCell" TargetType="TextBlock"><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text,RelativeSource={RelativeSource Self}}"/><Setter Property="VerticalAlignment" Value="Center"/></Style><Style x:Key="NameCell" TargetType="TextBlock" BasedOn="{StaticResource WrapCell}"><Setter Property="ToolTip" Value="{Binding CustomerTip}"/></Style><Style x:Key="RightCell" TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="Foreground" Value="{Binding TotalForeground}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Typography.NumeralAlignment" Value="Tabular"/></Style><Style x:Key="CenterCell" TargetType="TextBlock"><Setter Property="TextAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style><Style x:Key="CenterHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="HorizontalContentAlignment" Value="Center"/></Style><Style x:Key="RightHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="HorizontalContentAlignment" Value="Right"/></Style></DataGrid.Resources><DataGrid.Columns><DataGridTextColumn Header="Hora" Binding="{Binding Date}" ElementStyle="{StaticResource WrapCell}" Width="58"/><DataGridTemplateColumn Header="Cliente" SortMemberPath="Name" Width=".9*" MinWidth="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid VerticalAlignment="Center" HorizontalAlignment="Left" ToolTip="{Binding CustomerTip}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Phone}" Foreground="{DynamicResource Muted}"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Produto" Binding="{Binding Product}" ElementStyle="{StaticResource WrapCell}" Width="1.8*" MinWidth="80"/><DataGridTextColumn Header="Qtd." Binding="{Binding Quantity}" ElementStyle="{StaticResource CenterCell}" HeaderStyle="{StaticResource CenterHeader}" Width="62"/><DataGridTemplateColumn Header="Pagamento" SortMemberPath="Payment" Width="104"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="9" Padding="8,2,9,2" Background="{Binding PaymentSoft}" ToolTip="{Binding Payment}"><TextBlock FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"><Run Text="● " Foreground="{Binding PaymentBrush, Mode=OneWay}"/><Run Text="{Binding PaymentShort, Mode=OneWay}"/></TextBlock></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Total" Binding="{Binding Total}" ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" Width="100"/></D