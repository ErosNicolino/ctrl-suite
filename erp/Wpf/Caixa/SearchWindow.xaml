<Window x:Class="GraficaCaixa.Wpf.SearchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GraficaCaixa.Wpf" Title="Pesquisar lançamentos" Width="1050" Height="680" MinWidth="900" MinHeight="580" MaxWidth="1180" MaxHeight="780" WindowStartupLocation="CenterOwner" Icon="/Assets/icon.ico">
 <Grid Margin="34,26,34,32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18"><StackPanel><TextBlock Text="Pesquisar lançamentos" Style="{StaticResource Title}"/><TextBlock Text="Encontre vendas de caixas abertos ou fechados" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="RefundButton" Content="Devolver valor" Style="{StaticResource SoftButton}" VerticalAlignment="Center" Margin="0,0,8,0" Click="Refund_Click" IsEnabled="False" ToolTip="Devolver parte ou todo o valor ao cliente, em Dinheiro ou Pix (entra no caixa aberto de hoje)"/><Button x:Name="DetailsButton" Content="Ver detalhes" Style="{StaticResource SoftButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Details_Click" IsEnabled="False" ToolTip="Detalhes do lançamento selecionado (Enter ou duplo clique)"/></StackPanel></Grid>
  <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" local:SearchShortcut.IsTarget="True" TextChanged="SearchBox_TextChanged" ToolTip="Pesquise nome, telefone, produto, pagamento, data ou valor" Tag="Pesquise nome, telefone, produto, pagamento, data ou valor…"/><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"><DatePicker x:Name="FromDate" Width="150" ToolTip="Lançamentos a partir desta data" SelectedDateChanged="Filter_Changed"/><TextBlock Text="até" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource Muted}"/><DatePicker x:Name="ToDate" Width="150" ToolTip="Lançamentos até esta data" SelectedDateChanged="Filter_Changed"/><ComboBox x:Name="PaymentFilter" Width="170" Margin="12,0,0,0" ToolTip="Forma de pagamento" SelectionChanged="Filter_Changed"/></StackPanel><TextBlock x:Name="CountText" Grid.Column="2" MinWidth="145" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="18,0,0,0"/></Grid>
  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><Grid><DataGrid x:Name="Grid" MouseDoubleClick="Grid_DoubleClick" SelectionChanged="Grid_SelectionChanged" PreviewKeyDown="Grid_PreviewKeyDown"><DataGrid.Columns>
   <DataGridTextColumn Header="Data" Binding="{Binding Date}" SortMemberPath="Sale.CreatedAt" Width="144"/><DataGridTextColumn Header="Cliente / telefone" Binding="{Binding Customer}" Width="1.8*" ElementStyle="{StaticResource TrimCell}"/><DataGridTextColumn Header="Produto / referência" Binding="{Binding Product}" Width="1.6*" ElementStyle="{StaticResource TrimCell}"/><DataGridTextColumn Header="Qtd." Binding="{Binding Quantity}" SortMemberPath="Sale.Units" Width="64" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/><DataGridTextColumn Header="Pagamento" Binding="{Binding Payment}" Width="142" ElementStyle="{StaticResource TrimCell}"/><DataGridTextColumn Header="Total" Binding="{Binding Total}" SortMemberPath="Sale.Total" Width="96" HeaderStyle="{StaticResource MoneyHeader}"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MoneyCell}"><Setter Property="Foreground" Value="{Binding TotalForeground}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Caixa" Binding="{Binding SessionShort}" Width="126"/>
  </DataGrid.Columns></DataGrid><local:EmptyState x:Name="EmptyView" Title="Nenhum lançamento encontrado" Hint="Tente outro nome, telefone, produto, data ou valor." IsHitTestVisible="False" Visibility="Collapsed"/></Grid></Border>
 </Grid>
</Window>
