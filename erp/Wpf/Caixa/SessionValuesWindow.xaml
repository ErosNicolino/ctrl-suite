<Window x:Class="GraficaCaixa.Wpf.SessionValuesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GraficaCaixa.Wpf" Title="Editar fechamento" Width="660" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" Icon="/Assets/icon.ico">
 <local:DialogFrame x:Name="Frame" Kind="Neutro" IconName="archive" Title="Editar fechamento" Subtitle="Datas, horários e valores deste caixa · Enter avança · Ctrl+Enter salva · Esc fecha" ScrollBody="False">
  <local:DialogFrame.Footer><StackPanel Orientation="Horizontal"><Button Content="Cancelar" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Cancel_Click" ToolTip="Esc"/><Button Content="Salvar fechamento" Style="{StaticResource DialogPrimaryButton}" IsDefault="True" Click="Save_Click" ToolTip="Ctrl+Enter"/></StackPanel></local:DialogFrame.Footer>
  <StackPanel>
   <TextBlock Text="Período" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Data de abertura" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="OpenedDateBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Horário de abertura" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OpenedTimeBox" Tag="08:30"/><TextBlock x:Name="OpenedError" Style="{StaticResource FieldError}" Visibility="Collapsed"/></StackPanel></Grid>
   <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Data de fechamento" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="ClosedDateBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Horário de fechamento" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ClosedTimeBox" Tag="18:00"/><TextBlock x:Name="ClosedError" Style="{StaticResource FieldError}" Visibility="Collapsed"/></StackPanel></Grid>
   <TextBlock Text="Valores" Style="{StaticResource Eyebrow}" Margin="0,18,0,8"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Fundo inicial (R$)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OpeningBox" TextAlignment="Right"/><TextBlock x:Name="OpeningError" Style="{StaticResource FieldError}" Visibility="Collapsed"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Dinheiro contado (R$)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ClosingBox" TextAlignment="Right"/><TextBlock x:Name="ClosingError" Style="{StaticResource FieldError}" Visibility="Collapsed"/></StackPanel></Grid>
   <TextBlock Text="Responsáveis" Style="{StaticResource Eyebrow}" Margin="0,18,0,8"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Aberto por" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OpenedByBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Fechado por" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ClosedByBox"/></StackPanel></Grid>
   <Border Style="{StaticResource Note}" Margin="0,18,0,0"><TextBlock Text="O relatório PDF deste fechamento é atualizado automaticamente depois de salvar." TextWrapping="Wrap"/></Border>
  </StackPanel>
 </local:DialogFrame>
</Window>
