<Window x:Class="GraficaCaixa.Wpf.LostEntriesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GraficaCaixa.Wpf" Title="Lançamentos perdidos" Width="1050" Height="680" MinWidth="900" MinHeight="580" MaxWidth="1180" MaxHeight="780" WindowStartupLocation="CenterOwner" Icon="/Assets/icon.ico">
 <Grid Margin="34,26,34,32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,20"><StackPanel><TextBlock Text="Lançamentos perdidos" Style="{StaticResource Title}"/><TextBlock Text="Vendas que ficaram fora do fechamento normal" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel><Button Content="+ Novo lançamento" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Add_Click" ToolTip="Registrar uma venda que ficou fora do fechamento (Ctrl+N)"/></Grid>
  <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Tag="Pesquisar cliente, contato, descrição, pagamento, data ou valor…" ToolTip="Pesquise cliente, contato, descrição, pagamento, data ou valor"/><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"><Button x:Name="EditButton" Content="Editar" Style="{StaticResource SoftButton}" Click="Edit_Click" IsEnabled="False" ToolTip="Editar o lançamento selecionado (Enter ou duplo clique)"/><Button x:Name="RemoveButton" Content="Remover" Style="{StaticResource DangerCompactButton}" Margin="8,0,0,0" Click="Remove_Click" IsEnabled="False" ToolTip="Remover o lançamento selecionado (Delete). Pede confirmação."/></StackPanel></Grid>
  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><Grid><DataGrid x:Name="Grid" MouseDoubleClick="Grid_DoubleClick" SelectionChanged="Grid_SelectionChanged" PreviewKeyDown="Grid_PreviewKeyDown"><DataGrid.Columns>
   <DataGridTextColumn Header="Data" Binding="{Binding Date}" SortMemberPath="Entry.EntryDate" Width="1.1*"/><DataGridTextColumn Header="Cliente / quem foi" Binding="{Binding Customer}" Width="1.5*"/><DataGridTextColumn Header="Contato" Binding="{Binding Contact}" Width="1.2*"/><DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="1.8*"/><DataGridTextColumn Header="Pagamento" Binding="{Binding Payment}" Width="1.2*"/><DataGridTextColumn Header="Valor" Binding="{Binding Amount}" SortMemberPath="Entry.Amount" Width="1*" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/>
  </DataGrid.Columns></DataGrid><local:EmptyState x:Name="EmptyView" Title="Nenhum lançamento perdido" Hint="Use Novo lançamento para registrar o primeiro." IsHitTestVisible="False"/></Grid></Border>
  <DockPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="SummaryText" DockPanel.Dock="Right" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/><TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" Text="Carregando…"/></DockPanel>
 </Grid>
</Window>
