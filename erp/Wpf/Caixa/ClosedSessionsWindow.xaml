<Window x:Class="GraficaCaixa.Wpf.ClosedSessionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GraficaCaixa.Wpf" Title="Fechamentos" Width="1160" Height="740" MinWidth="980" MinHeight="620" MaxWidth="1220" MaxHeight="820" WindowStartupLocation="CenterOwner" Icon="/Assets/icon.ico">
 <Grid Margin="30,24,30,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18"><StackPanel><TextBlock Text="Fechamentos" Style="{StaticResource Title}"/><TextBlock Text="Histórico organizado do caixa e correções dos cinco fechamentos mais recentes" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="Histórico" Style="{StaticResource SoftButton}" Margin="0,0,7,0" Click="History_Click"/><Button Content="Relatórios gerais" Style="{StaticResource SoftButton}" Click="Reports_Click"/><Button Content="Lançamentos perdidos" Style="{StaticResource SoftButton}" Margin="7,0,0,0" Click="LostEntries_Click"/></StackPanel></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition/><RowDefinition Height="52"/></Grid.RowDefinitions><StackPanel Margin="20,14"><TextBlock Text="Histórico de caixas" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="SessionsCountText" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,0"/></StackPanel>
    <ListBox Grid.Row="1" x:Name="SessionList" BorderThickness="0" Background="Transparent" Padding="9,0" SelectionChanged="SessionList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="10,13"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="{Binding Date}" FontWeight="SemiBold"/><Border Background="{Binding StatusBackground}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Right"><TextBlock Text="{Binding Status}" Foreground="{Binding StatusForeground}" FontSize="11" FontWeight="Bold"/></Border></Grid><Grid Grid.Row="1" Margin="0,7,0,0"><StackPanel><TextBlock Text="{Binding Period}" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock Text="{Binding Count}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,0"/></StackPanel><TextBlock Text="{Binding Sales}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    <Border Grid.Row="2" Background="{DynamicResource SurfaceAlt}" Padding="14,10"><TextBlock Text="Selecione um fechamento para abrir todos os detalhes." Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/></Border>
   </Grid></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="84"/><RowDefinition Height="Auto"/><RowDefinition Height="50"/><RowDefinition/></Grid.RowDefinitions>
    <Grid Margin="20,0"><StackPanel VerticalAlignment="Center" Margin="0,0,185,0"><TextBlock x:Name="DetailTitle" Text="Selecione um fechamento" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="DetailPeriod" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel><Button x:Name="ValuesButton" Content="Editar fechamento" ToolTip="Alterar datas, horários, fundo inicial e dinheiro contado" Style="{StaticResource SoftButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Values_Click"/></Grid>
    <UniformGrid Grid.Row="1" Columns="4" Margin="20,0,20,12"><Border Background="{DynamicResource Hover}" CornerRadius="10" Padding="13" Margin="0,0,8,0"><StackPanel><TextBlock Text="Fundo inicial" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock x:Name="OpeningSummary" FontSize="18" Margin="0,7,0,0"/></StackPanel></Border><Border Background="{DynamicResource Hover}" CornerRadius="10" Padding="13" Margin="0,0,8,0"><StackPanel><TextBlock Text="Vendas" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock x:Name="SalesSummary" FontSize="18" Margin="0,7,0,0"/></StackPanel></Border><Border Background="{DynamicResource Hover}" CornerRadius="10" Padding="13" Margin="0,0,8,0"><StackPanel><TextBlock Text="Contado" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock x:Name="DeclaredSummary" FontSize="18" Margin="0,7,0,0"/></StackPanel></Border><Border Background="{DynamicResource Hover}" CornerRadius="10" Padding="13"><StackPanel><TextBlock Text="Diferença" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock x:Name="DifferenceSummary" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border></UniformGrid>
    <Border Grid.Row="2" x:Name="LockBanner" Background="{DynamicResource AccentSoft}" Padding="20,7"><TextBlock x:Name="LockText" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" TextWrapping="Wrap"/></Border>
    <Grid Grid.Row="3" Margin="20,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Lançamentos" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Lançamentos do fechamento"/><WrapPanel Grid.Column="1" HorizontalAlignment="Right"><Button x:Name="AddButton" Content="＋ Novo" Style="{StaticResource SoftButton}" Click="Add_Click" ToolTip="Incluir um lançamento neste fechamento (exige justificativa)"/><Button x:Name="EditButton" Content="Editar" Style="{StaticResource SoftButton}" Margin="6,0,0,0" Click="Edit_Click" ToolTip="Corrigir o lançamento selecionado (Enter ou duplo clique)"/><Button x:Name="RemoveButton" Content="Remover" Style="{StaticResource DangerCompactButton}" Margin="6,0,0,0" Click="Remove_Click" ToolTip="Cancelar o lançamento selecionado. O original é preservado e pede motivo."/></WrapPanel></Grid>
    <Grid Grid.Row="4"><DataGrid x:Name="Grid" MouseDoubleClick="Grid_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="106"/><DataGridTextColumn Header="Cliente / telefone" Binding="{Binding Customer}" Width="1.25*" ElementStyle="{StaticResource TrimCell}"/><DataGridTextColumn Header="Produto" Binding="{Binding Product}" Width="1.6*" ElementStyle="{StaticResource TrimCell}"/><DataGridTextColumn Header="Qtd." Binding="{Binding Quantity}" Width="74" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/><DataGridTemplateColumn Header="Pagamento" SortMemberPath="Payment" Width="104"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="9" Padding="8,2,9,2" Background="{Binding PaymentSoft}" ToolTip="{Binding Payment}"><TextBlock FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"><Run Text="● " Foreground="{Binding PaymentBrush, Mode=OneWay}"/><Run Text="{Binding Payment, Mode=OneWay}"/></TextBlock></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="92" HeaderStyle="{StaticResource MoneyHeader}"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MoneyCell}"><Setter Property="Foreground" Value="{Binding TotalForeground}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid><local:EmptyState x:Name="SalesEmpty" Title="Nenhum lançamento neste fechamento" Hint="Use Novo para adicionar um lançamento." IsHitTestVisible="False"/></Grid>
   </Grid></Border>
  </Grid>
 </Grid>
</Window>

