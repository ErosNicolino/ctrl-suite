<Window x:Class="GraficaCaixa.Wpf.ReportsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GraficaCaixa.Wpf" Title="Relatórios financeiros" Width="1280" Height="800" MinWidth="1020" MinHeight="650" WindowStartupLocation="CenterOwner" Icon="/Assets/icon.ico">
 <Window.Resources><DataTemplate x:Key="FinancialBar"><StackPanel Margin="0,5,0,10" Background="Transparent" ToolTip="{Binding Tip}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Margin="0,0,12,0"><Ellipse Width="9" Height="9" Fill="{Binding Color}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Share}" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Grid.Column="2" Text="{Binding Total}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/></Grid><Border Height="10" Background="{DynamicResource SurfaceAlt}" CornerRadius="4" Margin="0,6,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="{Binding Fill}"/><ColumnDefinition Width="{Binding Remainder}"/></Grid.ColumnDefinitions><Border Background="{Binding Color}" CornerRadius="4"/></Grid></Border></StackPanel></DataTemplate></Window.Resources>
 <Grid Margin="30,24,30,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock Text="Relatórios financeiros" Style="{StaticResource Title}"/><TextBlock Text="Visão consolidada das vendas, pedidos, custos, recebimentos e fechamentos." Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="Conciliação Pix" Style="{StaticResource SoftButton}" Margin="0,0,8,0" Click="Reconciliation_Click" ToolTip="Conferir o extrato do banco (OFX) com os PIX lançados"/><Button Content="Copiar resumo" Style="{StaticResource SoftButton}" Click="CopySummary_Click"/><Button Content="Fechar" Style="{StaticResource SoftButton}" Margin="8,0,0,0" Click="Close_Click"/></StackPanel></Grid>
  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="De" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/><DatePicker x:Name="StartDateBox" Grid.Column="1" SelectedDateChanged="Period_Changed"/><TextBlock Grid.Column="3" Text="Até" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/><DatePicker x:Name="EndDateBox" Grid.Column="4" SelectedDateChanged="Period_Changed"/><StackPanel Grid.Column="5" Orientation="Horizontal" Margin="14,0,0,0"><Button Content="Hoje" Style="{StaticResource SoftButton}" Click="Today_Click" Margin="0,0,7,0"/><Button Content="Este mês" Style="{StaticResource SoftButton}" Click="ThisMonth_Click"/><Button Content="Mês passado" Style="{StaticResource SoftButton}" Margin="7,0,0,0" Click="LastMonth_Click"/><Button Content="Últimos 30 dias" Style="{StaticResource SoftButton}" Margin="7,0,0,0" Click="Last30_Click"/><Button Content="Tudo" Style="{StaticResource SoftButton}" Margin="7,0,0,0" Click="AllTime_Click"/></StackPanel><TextBlock x:Name="PeriodText" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" FontSize="11" Margin="12,0,0,0" Grid.Column="6" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
  <TabControl Grid.Row="4">
   <TabItem Header="Visão financeira"><ScrollViewer Margin="0,16,0,0" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,6,0">
    <TextBlock Text="Resumo do período" Style="{StaticResource SectionTitle}" FontSize="16" Margin="2,0,0,8"/>
    <UniformGrid Columns="4">
     <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Recebido no período" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="RevenueText" Text="R$ 0,00" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock x:Name="RevenueHint" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Vendas e pedidos fechados" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="BilledText" Text="R$ 0,00" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="Pedidos + vendas diretas (sem contar parcelas de novo)" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0"><StackPanel><TextBlock x:Name="ProfitLabel" Text="Lucro bruto" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="ProfitText" Text="R$ 0,00" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,6,0,0"/><TextBlock x:Name="ProfitHint" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="A receber agora" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="ReceivableText" Text="R$ 0,00" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Warning}" Margin="0,6,0,0"/><TextBlock x:Name="ReceivableHint" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,4,0,0" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/></StackPanel></Border>
    </UniformGrid>
    <UniformGrid Columns="5" Margin="0,10,0,0">
     <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Custos conferidos" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="CostsText" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Média por recebimento" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="AverageTicketText" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Pedidos no período" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="OrdersTotalText" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Sangrias" Foreground="{DynamicResource Muted}" FontSize="12" ToolTip="Saídas de dinheiro físico; não são despesas de venda"/><TextBlock x:Name="WithdrawalsText" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Diferença de caixa" Foreground="{DynamicResource Muted}" FontSize="12" ToolTip="Contado no fechamento menos o dinheiro esperado"/><TextBlock x:Name="CashDifferenceText" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
    </UniformGrid>
    <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Resultado do período" Style="{StaticResource SectionTitle}"/><TextBlock Text="Demonstrativo simplificado: faturamento menos custos conferidos." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,10"/><StackPanel x:Name="DrePanel"/><TextBlock x:Name="DreText" Visibility="Collapsed"/></StackPanel></Border>
     <StackPanel Grid.Column="2">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Comparado ao período anterior" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="ComparisonText" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" LineHeight="24" Margin="0,10,0,0"/><TextBlock x:Name="ComparisonHint" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0"/><TextBlock Text="Mesmo período do ano passado" FontWeight="SemiBold" Margin="0,14,0,0"/><TextBlock x:Name="YearAgoText" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" LineHeight="24" Margin="0,4,0,0" Text="—"/><TextBlock x:Name="YearAgoHint" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel></Border>
      <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="10" Padding="16,12" Margin="0,12,0,0"><StackPanel><DockPanel><TextBlock x:Name="CoveragePercent" DockPanel.Dock="Right" FontWeight="SemiBold"/><TextBlock Text="Cobertura dos custos" FontWeight="SemiBold"/></DockPanel><Border Height="8" CornerRadius="4" Background="{DynamicResource Line}" Margin="0,8,0,0" ClipToBounds="True"><Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="CoverageFill" Width="0*"/><ColumnDefinition x:Name="CoverageRest" Width="1*"/></Grid.ColumnDefinitions><Border x:Name="CoverageBar" Background="{DynamicResource COk}" CornerRadius="4"/></Grid></Border><TextBlock x:Name="CoverageText" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" LineHeight="18" Margin="0,6,0,0"/></StackPanel></Border>
     </StackPanel>
    </Grid>
    <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="250"/></Grid.RowDefinitions><TextBlock Text="Recebido por forma de pagamento" Style="{StaticResource SectionTitle}" Margin="18,0" VerticalAlignment="Center"/><DataGrid Grid.Row="1" x:Name="PaymentGrid"><DataGrid.Columns><DataGridTextColumn Header="Forma" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Lançamentos" Binding="{Binding Count}" Width=".8*" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/><DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="*" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/><DataGridTextColumn Header="Participação" Binding="{Binding Share}" Width="*" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/></DataGrid.Columns></DataGrid></Grid></Border>
     <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="250"/></Grid.RowDefinitions><TextBlock Text="Recebido por produto / serviço" Style="{StaticResource SectionTitle}" Margin="18,0" VerticalAlignment="Center"/><DataGrid Grid.Row="1" x:Name="ProductGrid"><DataGrid.Columns><DataGridTextColumn Header="Produto / serviço" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource TrimCell}"/><DataGridTextColumn Header="Vendas" Binding="{Binding Count}" Width=".7*" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/><DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="*" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/></DataGrid.Columns></DataGrid></Grid></Border>
    </Grid>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Resumo do dia"><local:DaySummaryView x:Name="DayView"/></TabItem>
   <TabItem Header="Gráficos"><ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0"><StackPanel>
<TextBlock Text="Os valores numéricos permanecem nas tabelas. A evolução usa a data de cada recebimento e a data de criação de cada pedido/venda." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,14"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Recebimentos por pagamento" Style="{StaticResource SectionTitle}"/><ItemsControl x:Name="PaymentChart" ItemTemplate="{StaticResource FinancialBar}" Margin="0,14,0,0"/></StackPanel></Border>
<Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Pedidos do período: situação atual" Style="{StaticResource SectionTitle}"/><TextBlock Text="Recebido e pendente destes pedidos, inclusive pagamentos posteriores ao período." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,6,0,10"/><ItemsControl x:Name="BalanceChart" ItemTemplate="{StaticResource FinancialBar}"/></StackPanel></Border>
</Grid>
<Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Evolução dos recebimentos" Style="{StaticResource SectionTitle}"/><ItemsControl x:Name="ReceiptsChart" ItemTemplate="{StaticResource FinancialBar}" Margin="0,14,0,0"/></StackPanel></Border>
<Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Vendas / pedidos registrados" Style="{StaticResource SectionTitle}"/><ItemsControl x:Name="BilledChart" ItemTemplate="{StaticResource FinancialBar}" Margin="0,14,0,0"/></StackPanel></Border>
</Grid><Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Custos reais conferidos por período" Style="{StaticResource SectionTitle}"/><TextBlock Text="Mesma base dos indicadores: pedidos concluídos, data de criação e custo preservado no pedido. Consulte a cobertura para identificar custos não apurados." TextWrapping="Wrap" Margin="0,8"/><ItemsControl x:Name="CostChart" ItemTemplate="{StaticResource FinancialBar}"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Sangrias e ajustes"><Border Style="{StaticResource Card}" Margin="0,16,0,0"><DataGrid x:Name="WithdrawalsGrid" RowHeight="NaN" MinRowHeight="50"><DataGrid.Columns><DataGridTextColumn Header="Data / hora" Binding="{Binding Date}" SortMemberPath="CreatedAt" Width="160"/><DataGridTextColumn Header="Caixa" Binding="{Binding Session}" Width="110"/><DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="85"/><DataGridTextColumn Header="Usuário" Binding="{Binding User}" Width="130"/><DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,10"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Valor" Binding="{Binding Total}" Width="130" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/></DataGrid.Columns></DataGrid></Border></TabItem>
   <TabItem Header="Recebimentos"><Border Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0"><DataGrid x:Name="SalesGrid"><DataGrid.Columns><DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="1*"/><DataGridTextColumn Header="Cliente" Binding="{Binding Customer}" Width="1.6*" ElementStyle="{StaticResource TrimCell}"/><DataGridTextColumn Header="Produto / serviço" Binding="{Binding Product}" Width="2*" ElementStyle="{StaticResource TrimCell}"/><DataGridTextColumn Header="Pagamento" Binding="{Binding Payment}" Width="1*"/><DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="1*" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/></DataGrid.Columns></DataGrid></Border></TabItem>
   <TabItem Header="Pedidos e margens"><Border Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0"><DataGrid x:Name="OrdersGrid"><DataGrid.Columns><DataGridTextColumn Header="Pedido" Binding="{Binding Number}" Width=".65*"/><DataGridTextColumn Header="Cliente" Binding="{Binding Customer}" Width="1.3*" ElementStyle="{StaticResource TrimCell}"/><DataGridTemplateColumn Header="Status" SortMemberPath="Stage" Width="1.5*" MinWidth="175"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:StatusTag Text="{Binding Stage}" Tone="{Binding Stage,Converter={x:Static local:StatusTone.Instance}}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Venda" Binding="{Binding Total}" Width=".85*" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/><DataGridTextColumn Header="Recebido" Binding="{Binding Paid}" Width=".85*" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/><DataGridTextColumn Header="A receber" Binding="{Binding Remaining}" Width=".85*" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/><DataGridTextColumn Header="Custos" Binding="{Binding Costs}" Width=".85*" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/><DataGridTextColumn Header="Lucro" Binding="{Binding Profit}" Width=".85*" HeaderStyle="{StaticResource MoneyHeader}"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MoneyCell}"><Setter Property="Foreground" Value="{Binding MarginBrush}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Margem" Binding="{Binding Margin}" Width=".75*" HeaderStyle="{StaticResource MoneyHeader}"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MoneyCell}"><Setter Property="Foreground" Value="{Binding MarginBrush}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid></Border></TabItem>
   <TabItem Header="Fechamentos"><Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Ver detalhes" Style="{StaticResource SoftButton}" Click="Details_Click"/><Button Content="Gerar PDF" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Pdf_Click"/></StackPanel><Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="ClosingsGrid"><DataGrid.Columns><DataGridTextColumn Header="Versão" Binding="{Binding VersionText}" Width="1*"/><DataGridTextColumn Header="Abertura" Binding="{Binding Opened}" Width="1.2*"/><DataGridTextColumn Header="Fechamento" Binding="{Binding Closed}" Width="1.2*"/><DataGridTextColumn Header="Lançamentos" Binding="{Binding Count}" Width=".8*" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/><DataGridTextColumn Header="Total vendido" Binding="{Binding Sales}" Width="1*" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/><DataGridTextColumn Header="Dinheiro esperado" Binding="{Binding Expected}" Width="1.1*" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/><DataGridTextColumn Header="Contado" Binding="{Binding Declared}" Width="1*" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/><DataGridTemplateColumn Header="Diferença" Width="1*" HeaderStyle="{StaticResource MoneyHeader}"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Difference}" Foreground="{Binding DifferenceBrush}" FontWeight="SemiBold" Style="{StaticResource MoneyCell}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Border></Grid></TabItem>
   <TabItem Header="Cancelados"><Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition/></Grid.RowDefinitions>
     <TextBlock x:Name="CancelledHint" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Text="Lançamentos e pedidos cancelados no período, com o motivo informado. Eles não aparecem mais nas telas do dia a dia."/>
     <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="CancelledGrid" RowHeight="NaN" MinRowHeight="44"><DataGrid.Columns>
      <DataGridTextColumn Header="Cancelado em" Binding="{Binding Date}" SortMemberPath="CancelledAt" Width="140"/>
      <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="110"/>
      <DataGridTextColumn Header="Cliente" Binding="{Binding Customer}" Width="1.2*" ElementStyle="{StaticResource TrimCell}"/>
      <DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="1.6*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,8"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
      <DataGridTextColumn Header="Valor" Binding="{Binding Total}" Width="100" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/>
      <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="1.6*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,8"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
      <DataGridTextColumn Header="Usuário" Binding="{Binding User}" Width="110"/>
     </DataGrid.Columns></DataGrid></Border></Grid></TabItem>
   <TabItem Header="Fornecedores"><Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition/></Grid.RowDefinitions>
     <TextBlock x:Name="SupplierSpendHint" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Text="Quanto foi gasto em compras com cada fornecedor no período (Compras › Comprado). Compras não entram no caixa."/>
     <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="SupplierSpendGrid"><DataGrid.Columns><DataGridTextColumn Header="Fornecedor" Binding="{Binding Supplier}" Width="2*" ElementStyle="{StaticResource TrimCell}"/><DataGridTextColumn Header="Compras" Binding="{Binding Count}" Width="100"/><DataGridTextColumn Header="Total gasto" Binding="{Binding Total}" SortMemberPath="Amount" Width="140" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/><DataGridTextColumn Header="% do total" Binding="{Binding Share}" SortMemberPath="Amount" Width="110" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/></DataGrid.Columns></DataGrid></Border></Grid></TabItem>
   <TabItem Header="Curva ABC"><Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition/></Grid.RowDefinitions>
     <DockPanel><Border DockPanel.Dock="Left" Style="{StaticResource SegmentBar}" Margin="0,0,16,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><RadioButton x:Name="AbcProductsOption" Content="Produtos e serviços" Style="{StaticResource Segment}" GroupName="abc" IsChecked="True" Checked="AbcView_Changed"/><RadioButton Content="Clientes" Style="{StaticResource Segment}" GroupName="abc" Checked="AbcView_Changed"/></StackPanel></Border>
      <TextBlock x:Name="AbcSummary" DockPanel.Dock="Right" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/>
      <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Text="A: somam 80% do faturamento do período · B: até 95% · C: o restante. Margem em branco quando falta custo."/></DockPanel>
     <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><Grid>
      <DataGrid x:Name="AbcProductsGrid"><DataGrid.Columns>
       <DataGridTemplateColumn Header="Classe" SortMemberPath="Rank" Width="76"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border CornerRadius="10" Padding="10,2" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource SurfaceAlt}"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Class}" Value="A"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/></DataTrigger><DataTrigger Binding="{Binding Class}" Value="B"><Setter Property="Background" Value="{DynamicResource WarningSoft}"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Class}" FontWeight="Bold" ToolTip="{Binding ClassTip}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding Class}" Value="A"><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/></DataTrigger><DataTrigger Binding="{Binding Class}" Value="B"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="Produto / serviço" Binding="{Binding Name}" Width="2.4*" ElementStyle="{StaticResource TrimCell}"/>
       <DataGridTextColumn Header="Vendas" Binding="{Binding Count}" Width="80" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/>
       <DataGridTextColumn Header="Qtd." Binding="{Binding Quantity}" SortMemberPath="QuantityValue" Width="90" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/>
       <DataGridTextColumn Header="Faturamento" Binding="{Binding Revenue}" SortMemberPath="RevenueValue" Width="130" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/>
       <DataGridTextColumn Header="% do total" Binding="{Binding Share}" SortMemberPath="RevenueValue" Width="100" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/>
       <DataGridTextColumn Header="Acumulado" Binding="{Binding Cumulative}" SortMemberPath="Rank" Width="100" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/>
       <DataGridTemplateColumn Header="Margem" SortMemberPath="MarginValue" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Margin}" Foreground="{Binding MarginBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="{Binding MarginTip}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns></DataGrid>
      <DataGrid x:Name="AbcCustomersGrid" Visibility="Collapsed"><DataGrid.Columns>
       <DataGridTemplateColumn Header="Classe" SortMemberPath="Rank" Width="76"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border CornerRadius="10" Padding="10,2" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource SurfaceAlt}"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Class}" Value="A"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/></DataTrigger><DataTrigger Binding="{Binding Class}" Value="B"><Setter Property="Background" Value="{DynamicResource WarningSoft}"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Class}" FontWeight="Bold" ToolTip="{Binding ClassTip}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding Class}" Value="A"><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/></DataTrigger><DataTrigger Binding="{Binding Class}" Value="B"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="Cliente" Binding="{Binding Name}" Width="2.4*" ElementStyle="{StaticResource TrimCell}"/>
       <DataGridTextColumn Header="Compras" Binding="{Binding Count}" Width="90" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/>
       <DataGridTextColumn Header="Faturamento" Binding="{Binding Revenue}" SortMemberPath="RevenueValue" Width="130" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/>
       <DataGridTextColumn Header="% do total" Binding="{Binding Share}" SortMemberPath="RevenueValue" Width="100" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/>
       <DataGridTextColumn Header="Acumulado" Binding="{Binding Cumulative}" SortMemberPath="Rank" Width="100" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/>
       <DataGridTemplateColumn Header="Margem" SortMemberPath="MarginValue" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Margin}" Foreground="{Binding MarginBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="{Binding MarginTip}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns></DataGrid></Grid></Border></Grid></TabItem>
  </TabControl>
 </Grid>
