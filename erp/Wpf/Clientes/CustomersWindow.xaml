<Window x:Class="GraficaCaixa.Wpf.CustomersWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Clientes" Width="1180" Height="720" MinWidth="980" MinHeight="600" WindowStartupLocation="CenterOwner" Icon="/Assets/icon.ico" xmlns:local="clr-namespace:GraficaCaixa.Wpf">
 <Grid Margin="24,22,24,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18"><Button DockPanel.Dock="Right" Content="+ Novo cliente" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Click="NewCustomer_Click" ToolTip="Cadastrar um cliente (também nascem sozinhos dos lançamentos e pedidos)"/><StackPanel><TextBlock Text="Clientes" Style="{StaticResource Title}"/><TextBlock Text="Compras, pedidos e valores pendentes em uma só ficha · clique no WhatsApp para abrir a conversa" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel></DockPanel>
  <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="SearchBox" local:SearchShortcut.IsTarget="True" ToolTip="Pesquisar nome ou telefone" Tag="Pesquisar nome ou telefone…" TextChanged="SearchBox_TextChanged"/>
   <CheckBox Grid.Column="1" x:Name="IncompleteBox" Content="Só incompletos" VerticalAlignment="Center" Margin="16,0,0,0" Click="Incomplete_Click" ToolTip="Sem nome, nome só com números ou telefone incompleto: cadastros antigos para corrigir ou excluir"/>
   <Button Grid.Column="2" x:Name="PurgeButton" Style="{StaticResource DangerButton}" Margin="16,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" Click="Purge_Click" ToolTip="Exclui de uma vez os cadastros sem telefone completo com DDD (quem tem número completo, mesmo sem nome, fica)"/>
   <CheckBox Grid.Column="3" x:Name="DuplicatesBox" Content="Telefones repetidos" VerticalAlignment="Center" Margin="16,0,0,0" Click="Incomplete_Click" ToolTip="Cadastros com o mesmo telefone, agrupados: selecione 2 ou mais (Ctrl+clique) e use Mesclar"/>
   <Button Grid.Column="4" x:Name="MergeButton" Content="Mesclar selecionados" Style="{StaticResource PrimaryButton}" Margin="16,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" Click="Merge_Click" ToolTip="Une os cadastros selecionados do mesmo telefone em um só"/>
  </Grid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*" MaxWidth="320"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True"><Grid><DataGrid x:Name="Grid" SelectionMode="Extended" SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Grid_DoubleClick" RowHeight="38" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><DataGrid.Resources><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="MinHeight" Value="38"/></Style></DataGrid.Resources><DataGrid.Columns><DataGridTemplateColumn Header="Cliente" SortMemberPath="Name" Width="1.5*" MinWidth="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel VerticalAlignment="Center" Margin="10,0,6,0" Background="Transparent"><local:UiIcon IconName="circle-alert" Width="15" Height="15" Margin="0,0,6,0" Foreground="{DynamicResource Warning}" Visibility="{Binding IncompleteVisibility}" ToolTip="Completar cadastro: falta nome ou telefone completo com DDD. Use Editar nome e telefone."/><Border DockPanel.Dock="Right" Visibility="{Binding PriceTypeVisibility}" CornerRadius="8" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center" Background="{DynamicResource InfoSoft}" ToolTip="Tipo de preço (desconto automático)"><TextBlock Text="{Binding PriceType}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Info}"/></Border><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Name}"/></DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Telefone" SortMemberPath="Contact" Width="1.1*" MinWidth="168"><DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel VerticalAlignment="Center"><local:WhatsAppButton DockPanel.Dock="Left" Compact="True" Phone="{Binding Contact}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Contact}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Pedidos" Binding="{Binding OrdersDisplay}" SortMemberPath="Orders" Width=".5*" MinWidth="70" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/><DataGridTextColumn Header="Recebido" Binding="{Binding Total}" Width=".65*" MinWidth="88" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/><DataGridTextColumn Header="A receber" Binding="{Binding Pending}" Width=".65*" MinWidth="88" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/><DataGridTextColumn Header="Últ. pedido" Binding="{Binding LastOrder}" Width=".75*" MinWidth="106"/></DataGrid.Columns></DataGrid></Grid></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><local:EmptyState x:Name="DetailEmpty" IconName="users" Title="Escolha um cliente" Hint="A ficha mostra pedidos, recebimentos e o que falta receber. Use ↑ ↓ na lista ou clique numa linha." ActionText="Novo cliente" Action="NewCustomer_Click"/><Grid x:Name="DetailContent" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="DetailName" Text="Selecione um cliente" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="DetailContact" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/><DockPanel Margin="0,12,0,0"><TextBlock Text="Tipo de preço" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="PriceTypeBox" SelectionChanged="PriceType_Changed"/></DockPanel></StackPanel><UniformGrid Grid.Row="1" Columns="3" Margin="0,20,0,18"><StackPanel><TextBlock Text="Pedidos" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock x:Name="DetailOrders" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel><TextBlock Text="Recebido" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock x:Name="DetailTotal" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel><TextBlock Text="A receber" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock x:Name="DetailPending" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,5,0,0"/></StackPanel></UniformGrid><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="DetailHistory" Text="Escolha uma linha para ver o histórico." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="22"/></ScrollViewer><StackPanel Grid.Row="3"><UniformGrid Columns="2" Margin="0,12,0,0"><Button Content="Editar" ToolTip="Editar nome e telefone" Style="{StaticResource SoftButton}" Margin="0,0,4,0" Click="EditCustomer_Click"/><Button x:Name="DeleteButton" Content="Excluir" Style="{StaticResource DangerCompactButton}" Margin="4,0,0,0" Click="DeleteCustomer_Click" ToolTip="Exclui só o cadastro. Pedidos e lançamentos continuam com o nome registrado. Ctrl ou Shift para selecionar vários."/></UniformGrid><UniformGrid Columns="2" Margin="0,8,0,0"><Button x:Name="OpenOrdersButton" Content="Abrir pedidos" ToolTip="Abrir os pedidos deste cliente" Style="{StaticResource PrimaryButton}" Margin="0,0,4,0" Click="OpenOrders_Click" IsEnabled="False"/><Button x:Name="RepeatLastButton" Content="Repetir último" ToolTip="Novo pedido com os mesmos itens e preços do último pedido; você confere antes de salvar" Style="{StaticResource SoftButton}" Margin="4,0,0,0" Click="RepeatLast_Click" IsEnabled="{Binding IsEnabled,ElementName=OpenOrdersButton}"/></UniformGrid></StackPanel></Grid></Grid></Border>
  </Grid>
 </Grid>
</Window>
