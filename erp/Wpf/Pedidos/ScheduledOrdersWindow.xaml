<Window x:Class="GraficaCaixa.Wpf.ScheduledOrdersWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GraficaCaixa.Wpf" Title="Pedidos e produção" Width="1260" Height="800" MinWidth="1050" MinHeight="660" WindowStartupLocation="CenterOwner" Icon="/Assets/icon.ico">
 <Window.Resources>
  <Style x:Key="OrderText" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="MaxHeight" Value="48"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="StageText" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="16"/><Setter Property="MaxHeight" Value="32"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="ToolTip" Value="{Binding Stage}"/></Style>
  <Style x:Key="OrderCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="Transparent"><ContentPresenter Margin="7,0" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid x:Name="PageRoot" Margin="28" SizeChanged="PageRoot_SizeChanged"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
 <DockPanel x:Name="PageHeader" Margin="0,0,0,18"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"><local:ViewToggle x:Name="OrdersView" Mode="Lista" SecondLabel="Quadro" SecondIcon="square-kanban" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Lista ou quadro por etapa (a escolha fica gravada)"/><Button Content="Avisar retiradas" Style="{StaticResource SoftButton}" Margin="0,0,8,0" Click="PickupReminders_Click" ToolTip="Abre o WhatsApp de quem tem pedido pronto há alguns dias (Regras), com a mensagem de lembrete pronta"/><Button Content="Novo pedido" Style="{StaticResource PrimaryButton}" Click="Add_Click"/></StackPanel><StackPanel><TextBlock Text="Pedidos e produção" Style="{StaticResource Title}"/><TextBlock Text="Acompanhe cada etapa, os valores e as fichas já geradas" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel></DockPanel>
 <UniformGrid x:Name="KpiRow" Grid.Row="2" Columns="4" Margin="0,0,0,16"><local:KpiCard x:Name="ActiveKpi" Label="Em andamento" Hint="arte, aprovação e produção" Tone="info" IsLoading="True" Margin="0,0,10,0"/><local:KpiCard x:Name="UrgentKpi" Label="Prioridade / atraso" Hint="vence em até 3 dias úteis ou atrasado" IsLoading="True" Margin="0,0,10,0"/><local:KpiCard x:Name="ProductionKpi" Label="Em produção" Tone="violet" IsLoading="True" Margin="0,0,10,0"/><local:KpiCard x:Name="PendingKpi" Label="Com saldo pendente" Tone="warn" IsLoading="True"/></UniformGrid>
 <Grid Grid.Row="3" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="FilterColumn" Width="190"/></Grid.ColumnDefinitions><WrapPanel><Button x:Name="ActiveButton" Content="Em andamento" ToolTip="Pedidos que ainda dependem da gráfica: arte, aprovação e produção" Style="{StaticResource SoftButton}" Click="Active_Click"/><Button x:Name="ReadyButton" Content="Aguardando retirada" ToolTip="Pedidos prontos esperando o cliente retirar, do mais antigo para o mais novo" Style="{StaticResource SoftButton}" Margin="8,0,0,0" Click="Ready_Click"/><Button x:Name="CompletedButton" Content="Concluídos" Style="{StaticResource SoftButton}" Margin="8,0,0,0" Click="Completed_Click"/><Button x:Name="UnpaidButton" Content="Falta pagamento" Style="{StaticResource SoftButton}" Margin="8,0,0,0" Click="Unpaid_Click"/><Button x:Name="UnprintedButton" Content="Sem ficha" ToolTip="Pedidos em andamento que ainda não tiveram a ficha gerada" Style="{StaticResource SoftButton}" Margin="8,0,0,0" Click="Unprinted_Click"/><Button x:Name="ArchivedButton" Content="Arquivados" ToolTip="Pedidos arquivados (cliente sumiu ou não retirou). Selecione um e use Desarquivar para continuar" Style="{StaticResource SoftButton}" Margin="8,0,8,0" Click="Archived_Click"/></WrapPanel><ComboBox Grid.Column="1" x:Name="FilterBox" Margin="12,0,0,0" VerticalAlignment="Top" SelectionChanged="FilterBox_SelectionChanged"/></Grid>
 <DockPanel Grid.Row="4" Margin="0,0,0,14"><TextBox DockPanel.Dock="Right" Width="270" Margin="12,0,0,0" VerticalAlignment="Top" x:Name="SearchBox" local:SearchShortcut.IsTarget="True" ToolTip="Pesquisar número, cliente, contato, item ou etapa" Tag="Pesquisar número, cliente, contato, item…" TextChanged="SearchBox_TextChanged"/><WrapPanel><Button x:Name="PaymentButton" Content="Registrar pagamento" ToolTip="Receber o saldo do pedido selecionado" Style="{StaticResource SoftButton}" Margin="0,0,7,0" Click="MarkPaid_Click" IsEnabled="False"/><Button Content="Gerar e imprimir ficha" Style="{StaticResource SoftButton}" ToolTip="Selecione até dois pedidos. O PDF será salvo na pasta de impressões configurada e aberto para você escolher a impressora." Click="OrderPdf_Click"/><Button x:Name="ReceiptButton" Content="Recibo PDF" ToolTip="Gerar o recibo dos pagamentos do pedido" Style="{StaticResource SoftButton}" Margin="7,0,0,0" Click="Receipt_Click" IsEnabled="False"/><Button x:Name="TrackingButton" Content="Link de acompanhamento" ToolTip="Abre o WhatsApp do cliente com o link para ele acompanhar o pedido" Style="{StaticResource SoftButton}" Margin="7,0,0,0" Click="Tracking_Click" Visibility="Collapsed"/><Button x:Name="EditButton" Content="Editar pedido" ToolTip="Editar cliente, itens, etapa, prazo e pagamentos (Enter ou duplo clique)" Style="{StaticResource SoftButton}" Margin="7,0" Click="Edit_Click" IsEnabled="False"/><Button x:Name="MoreButton" Content="Mais ▾" ToolTip="Histórico, custo, repetir, arquivar e cancelar pedido" Style="{StaticResource SoftButton}" Click="More_Click"/><StackPanel x:Name="MoreActions" Visibility="Collapsed"><Button Content="Histórico" ToolTip="Quem alterou o pedido e quando" Style="{StaticResource SoftButton}" Margin="7,0,0,0" Click="History_Click"/><Button x:Name="CostButton" Content="Custo" ToolTip="Informar o custo de produção do pedido" Style="{StaticResource SoftButton}" Margin="7,0,0,0" Click="Cost_Click" IsEnabled="False"/><Button x:Name="RepeatButton" Content="Repetir" ToolTip="Novo pedido com o mesmo cliente, itens e preços; você confere antes de salvar" Style="{StaticResource SoftButton}" Margin="7,0,0,0" Click="Repeat_Click" IsEnabled="False"/><Button x:Name="ArchiveButton" Content="Arquivar pedido" ToolTip="Tirar da lista um pedido que o cliente não retirou" Style="{StaticResource SoftButton}" Click="Archive_Click" IsEnabled="False"/><Button x:Name="RemoveButton" Content="Cancelar pedido" ToolTip="Cancelar o pedido (pede confirmação e motivo)" Style="{StaticResource DangerCompactButton}" Margin="7,0,0,0" Click="Remove_Click" IsEnabled="False"/></StackPanel></WrapPanel></DockPanel>
 <Border Grid.Row="5" Style="{StaticResource Card}" Padding="0"><Grid>
  <DataGrid x:Name="Grid" Sorting="Grid_Sorting" SelectionMode="Extended" SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Grid_DoubleClick" RowHeight="56" FontSize="12" CellStyle="{StaticResource OrderCell}">
   <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="Background" Value="{Binding RowBackground}"/><Setter Property="BorderBrush" Value="{Binding StripeBrush}"/><Setter Property="BorderThickness" Value="5,0,0,0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Selected}"/></Trigger></Style.Triggers></Style></DataGrid.RowStyle>
   <DataGrid.Columns>
    <DataGridTextColumn Header="Nº" SortMemberPath="NumberValue" Binding="{Binding Number}" Width="52"/>
    <DataGridTemplateColumn Header="Situação" SortMemberPath="Urgency" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding UrgencyBackground}" CornerRadius="7" Padding="6,4" HorizontalAlignment="Left"><TextBlock Text="{Binding Urgency}" Foreground="{Binding UrgencyForeground}" FontSize="11" FontWeight="Bold"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="Data" Binding="{Binding Created}" SortMemberPath="CreatedAt" Width="80" ElementStyle="{StaticResource OrderText}"/>
    <DataGridTemplateColumn Header="Cliente e itens" SortMemberPath="Customer" Width="2.4*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><Border Background="{DynamicResource DangerSoft}" CornerRadius="4" HorizontalAlignment="Left" Padding="5,1" Margin="0,0,0,2"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsLoss}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="PERDA" Foreground="{DynamicResource Danger}" FontSize="10" FontWeight="SemiBold"/></Border><TextBlock Text="{Binding Customer}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" ToolTip="{Binding Description}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="Etapa" SortMemberPath="StageBarWidth" Width="122"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Stage}" Style="{StaticResource StageText}"/><Border Width="100" Height="5" CornerRadius="2.5" HorizontalAlignment="Left" Margin="0,5,0,0" Background="{DynamicResource Line}" ToolTip="{Binding Stage}"><Border Width="{Binding StageBarWidth}" HorizontalAlignment="Left" CornerRadius="2.5" Background="{DynamicResource Accent}"/></Border></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="Prazo" SortMemberPath="DueDate" Binding="{Binding Due}" Width="118" ElementStyle="{StaticResource OrderText}"/>
    <DataGridTemplateColumn Header="Saldo" SortMemberPath="RemainingAmount" Width="102" HeaderStyle="{StaticResource MoneyHeader}"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid VerticalAlignment="Center" HorizontalAlignment="Right" ToolTip="{Binding PaymentSummary}"><local:StatusTag Text="Quitado" Tone="ok" HorizontalAlignment="Right"><local:StatusTag.Style><Style TargetType="local:StatusTag" BasedOn="{StaticResource {x:Type local:StatusTag}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Settled}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:StatusTag.Style></local:StatusTag><StackPanel HorizontalAlignment="Right"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Settled}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="{Binding BalanceMain}" FontWeight="SemiBold" Foreground="{DynamicResource Danger}" HorizontalAlignment="Right"/><TextBlock Text="{Binding BalanceSub}" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Right"/></StackPanel></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="Ficha" Width="64"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding PrintStatus}" ToolTip="{Binding PrintHint}" TextWrapping="Wrap" FontSize="11"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   <DataGridTextColumn Header="Lucro" SortMemberPath="ProfitValue" Binding="{Binding Profit}" Width="84" HeaderStyle="{StaticResource MoneyHeader}"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MoneyCell}"><Setter Property="Foreground" Value="{Binding ProfitBrush}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns>
  </DataGrid>
  <local:EmptyState x:Name="EmptyView" Visibility="Collapsed" Title="Nenhum pedido nesta visualização" Hint="Tente outro nome, número ou etapa." ActionText="Limpar filtros" Action="ClearFilters_Click"/>
 </Grid></Border>
 </Grid>
</Window>


