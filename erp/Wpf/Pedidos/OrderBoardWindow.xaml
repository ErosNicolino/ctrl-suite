<Window x:Class="GraficaCaixa.Wpf.OrderBoardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GraficaCaixa.Wpf" Title="Painel visual de pedidos" Width="1160" Height="740" MinWidth="980" MinHeight="620" WindowStartupLocation="CenterOwner" Icon="/Assets/icon.ico">
 <!-- UX 2.0 (pacote 4): quadro (P8) como segunda vista de Pedidos. Mesmas 4 colunas, mesma ordem e mesmo duplo clique. -->
 <Window.Resources>
  <DataTemplate x:Key="BoardCard"><Border Background="{Binding Background}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Margin="6,4" ToolTip="Dois cliques para abrir o pedido"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="{Binding Stripe}" CornerRadius="10,0,0,10"/><StackPanel Grid.Column="1" Margin="12,11,12,11">
   <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Payment}" ToolTip="Saldo a receber" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{Binding PaymentBrush}"/><TextBlock Text="{Binding Customer}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Customer}"/></DockPanel>
   <TextBlock Text="{Binding Due}" Foreground="{Binding DueBrush}" FontSize="11.5" FontWeight="SemiBold" Margin="0,2,0,0"/>
   <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" MaxHeight="34" LineHeight="17" LineStackingStrategy="BlockLineHeight" FontSize="12.5" ToolTip="{Binding Description}"/>
   <TextBlock Margin="0,8,0,0" Text="{Binding StageLine}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StageLine}"/>
  </StackPanel></Grid></Border></DataTemplate>
  <Style x:Key="ColumnTitle" TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
  <Style x:Key="ColumnCount" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="8,1"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Right"/></Style>
  <Style x:Key="BoardList" TargetType="ListBox"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0,0,0,6"/></Style>
 </Window.Resources>
 <Grid Margin="28,22,28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><local:ViewToggle x:Name="OrdersView" Mode="Cards" SecondLabel="Quadro" SecondIcon="square-kanban" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Lista ou quadro por etapa (a escolha fica gravada)"/><Button Content="Avisar retiradas" Style="{StaticResource SoftButton}" Margin="0,0,8,0" Click="PickupReminders_Click" ToolTip="Abre o WhatsApp de quem tem pedido pronto há alguns dias (Regras), com a mensagem de lembrete pronta"/><Button x:Name="NewOrderButton" Content="Novo pedido" Style="{StaticResource PrimaryButton}" Click="NewOrder_Click"/></StackPanel>
   <StackPanel><TextBlock Text="Pedidos e produção" Style="{StaticResource Title}"/><TextBlock Text="Quadro por etapa · dois cliques abre o pedido" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DockPanel>
  <UniformGrid Grid.Row="1" Columns="4">
   <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="0" Background="{DynamicResource SurfaceAlt}"><Grid><Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition/></Grid.RowDefinitions><Grid Margin="14,0"><StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="{DynamicResource CViolet}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Entrada e arte" Style="{StaticResource ColumnTitle}"/></StackPanel><Border Style="{StaticResource ColumnCount}"><TextBlock x:Name="EntryCount" FontSize="12" FontWeight="SemiBold"/></Border></Grid><ListBox Grid.Row="1" x:Name="EntryList" Style="{StaticResource BoardList}" MouseDoubleClick="Card_DoubleClick" ItemTemplate="{StaticResource BoardCard}"/></Grid></Border>
   <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="0" Background="{DynamicResource SurfaceAlt}"><Grid><Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition/></Grid.RowDefinitions><Grid Margin="14,0"><StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="{DynamicResource CWarn}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Aprovação" Style="{StaticResource ColumnTitle}"/></StackPanel><Border Style="{StaticResource ColumnCount}"><TextBlock x:Name="ApprovalCount" FontSize="12" FontWeight="SemiBold"/></Border></Grid><ListBox Grid.Row="1" x:Name="ApprovalList" Style="{StaticResource BoardList}" MouseDoubleClick="Card_DoubleClick" ItemTemplate="{StaticResource BoardCard}"/></Grid></Border>
   <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="0" Background="{DynamicResource SurfaceAlt}"><Grid><Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition/></Grid.RowDefinitions><Grid Margin="14,0"><StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="{DynamicResource CInfo}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Produção" Style="{StaticResource ColumnTitle}"/></StackPanel><Border Style="{StaticResource ColumnCount}"><TextBlock x:Name="ProductionCount" FontSize="12" FontWeight="SemiBold"/></Border></Grid><ListBox Grid.Row="1" x:Name="ProductionList" Style="{StaticResource BoardList}" MouseDoubleClick="Card_DoubleClick" ItemTemplate="{StaticResource BoardCard}"/></Grid></Border>
   <Border Style="{StaticResource Card}" Padding="0" Background="{DynamicResource SurfaceAlt}"><Grid><Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition/></Grid.RowDefinitions><Grid Margin="14,0"><StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="{DynamicResource COk}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Finalização" Style="{StaticResource ColumnTitle}"/></StackPanel><Border Style="{StaticResource ColumnCount}"><TextBlock x:Name="FinishCount" FontSize="12" FontWeight="SemiBold"/></Border></Grid><ListBox Grid.Row="1" x:Name="FinishList" Style="{StaticResource BoardList}" MouseDoubleClick="Card_DoubleClick" ItemTemplate="{StaticResource BoardCard}"/></Grid></Border>
  </UniformGrid>
 </Grid>
</Window>
