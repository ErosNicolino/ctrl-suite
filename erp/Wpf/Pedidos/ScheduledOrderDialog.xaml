<?xml version="1.0" encoding="utf-8"?>
<!-- UX 2.0 (pacote 2): diálogo central verde "Novo pedido". As 4 etapas viram passos numerados que ganham ✓; resumo ao vivo à direita
     (em telas estreitas, volta a faixa de totais embaixo); rodapé fixo. Todos os campos e nomes (x:Name) foram mantidos. -->
<Window x:Class="GraficaCaixa.Wpf.ScheduledOrderDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GraficaCaixa.Wpf" Title="Pedido" Width="1180" Height="760" MinWidth="760" MinHeight="620" Background="{DynamicResource Surface}" FontSize="13.5" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Icon="/Assets/icon.ico">
 <Window.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource Line}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Padding" Value="16,14" /></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style x:Key="OrderInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Height" Value="36" /><Setter Property="FontSize" Value="13.5" /></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource OrderInput}" />
  <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Height" Value="36" /><Setter Property="FontSize" Value="13.5" /></Style>
  <Style TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}"><Setter Property="Height" Value="36" /><Setter Property="FontSize" Value="13.5" /></Style>
  <Style x:Key="OrderSoft" TargetType="Button" BasedOn="{StaticResource SmallButton}" />
  <Style x:Key="OrderPrimary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="12,4" /><Setter Property="MinHeight" Value="32" /></Style>
  <Style x:Key="OrderDelete" TargetType="Button" BasedOn="{StaticResource DangerCompactButton}"><Setter Property="Padding" Value="8" /><Setter Property="Width" Value="44" /><Setter Property="Height" Value="40" /><Setter Property="MinHeight" Value="38" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style x:Key="FieldTitle" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="12.8" /><Setter Property="Margin" Value="0,0,0,6" /></Style>
  <!-- Passos numerados (as 4 etapas): círculo com o número, ✓ quando a etapa está completa, sublinhado verde na atual. -->
  <Style TargetType="TabControl"><Setter Property="BorderThickness" Value="0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions><Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><UniformGrid Columns="4" IsItemsHost="True" Margin="0,0,0,-1" /></Border><ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" Margin="0,12,0,0" TextElement.Foreground="{DynamicResource Ink}" TextElement.FontWeight="Normal" /></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="FontSize" Value="13.5" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Grid Background="Transparent"><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="4,0"><StackPanel Orientation="Horizontal" Margin="0,9,0,11"><Border x:Name="Circle" Background="{DynamicResource SurfaceAlt}" Width="26" Height="26" CornerRadius="13"><Grid><TextBlock x:Name="Num" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Muted}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" /><local:UiIcon x:Name="Tick" IconName="check" Width="14" Height="14" StrokeWidth="2.6" Foreground="{DynamicResource OnK}" Visibility="Collapsed" /></Grid></Border><ContentPresenter x:Name="StepHeader" TextElement.Foreground="{DynamicResource Muted}" TextElement.FontWeight="SemiBold" ContentSource="Header" VerticalAlignment="Center" Margin="9,0,0,0" /></StackPanel></Viewbox><Border x:Name="Underline" Height="3" VerticalAlignment="Bottom" CornerRadius="2" Margin="4,0" Background="{DynamicResource Accent}" Visibility="Collapsed" /></Grid><ControlTemplate.Triggers><Trigger Property="local:Ui.IsDone" Value="True"><Setter TargetName="Circle" Property="Background" Value="{DynamicResource Accent}" /><Setter TargetName="Num" Property="Visibility" Value="Collapsed" /><Setter TargetName="Tick" Property="Visibility" Value="Visible" /><Setter TargetName="StepHeader" Property="TextElement.Foreground" Value="{DynamicResource Ink}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Underline" Property="Visibility" Value="Visible" /><Setter TargetName="StepHeader" Property="TextElement.Foreground" Value="{DynamicResource AccentInk}" /><Setter TargetName="Num" Property="Foreground" Value="{DynamicResource AccentInk}" /></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSelected" Value="True" /><Condition Property="local:Ui.IsDone" Value="False" /></MultiTrigger.Conditions><Setter TargetName="Circle" Property="Background" Value="{DynamicResource AccentSoft}" /></MultiTrigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StepHeader" Property="TextElement.Foreground" Value="{DynamicResource Ink}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <local:DialogFrame x:Name="Frame" Kind="Pedido" IconName="clipboard-list" Title="{Binding Text, ElementName=TitleText}" Subtitle="Cliente, itens, prazo e pagamento · Enter avança · Ctrl+Enter salva · Esc fecha" ScrollBody="False" AsideWidth="300">
  <local:DialogFrame.HeaderExtra><StackPanel Orientation="Horizontal"><Button Content="Observações" Style="{StaticResource OrderSoft}" Margin="0,0,8,0" Click="Notes_Click" ToolTip="Observações que saem na ficha de produção" /><Button Content="Calculadora" Style="{StaticResource OrderSoft}" Click="Calculator_Click" /><Button x:Name="PdfButton" Content="PDF" Style="{StaticResource OrderSoft}" Margin="8,0,0,0" Visibility="Collapsed" ToolTip="Gerar a ficha do pedido em PDF: abrir, salvar ou enviar pelo WhatsApp" Click="Pdf_Click" /><Button x:Name="HistoryButton" Content="Histórico" Style="{StaticResource OrderSoft}" Margin="8,0,0,0" Visibility="Collapsed" ToolTip="Consultar a auditoria deste pedido" Click="History_Click" /></StackPanel></local:DialogFrame.HeaderExtra>
  <local:DialogFrame.Aside>
   <StackPanel x:Name="AsidePanel">
    <Border Style="{StaticResource SummaryCard}"><StackPanel>
     <TextBlock Text="TOTAL DO PEDIDO" Style="{StaticResource Eyebrow}" Margin="0" />
     <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="{Binding Text, ElementName=SummaryTotal}" Style="{StaticResource SummaryValue}" /></Viewbox>
     <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Recebido" /><TextBlock Grid.Column="1" Text="{Binding Text, ElementName=SummaryPaid}" FontWeight="SemiBold" /></Grid>
     <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Saldo" /><TextBlock x:Name="AsideBalanceText" Grid.Column="1" Text="{Binding Text, ElementName=SummaryBalance}" FontWeight="SemiBold" /></Grid>
     <WrapPanel Margin="0,10,0,0"><Button x:Name="DepositHalfButton" Content="Sinal de 50%" Style="{StaticResource OrderSoft}" Margin="0,0,6,6" Click="QuickDeposit_Click" ToolTip="Preenche um recebimento de 50% do saldo (você confere a forma em Valores e pagamentos)" /><Button x:Name="PayAllButton" Content="Quitar" Style="{StaticResource OrderSoft}" Margin="0,0,6,6" Click="QuickPayAll_Click" ToolTip="Preenche um recebimento do saldo total (você confere a forma em Valores e pagamentos)" /></WrapPanel>
     <Separator Margin="0,6,0,8" />
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Entrega" Foreground="{DynamicResource Muted}" Margin="0,0,10,0" /><TextBlock x:Name="AsideDueText" Grid.Column="1" TextWrapping="Wrap" TextAlignment="Right" FontWeight="SemiBold" /></Grid>
     <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Etapa" Foreground="{DynamicResource Muted}" Margin="0,0,10,0" /><TextBlock Grid.Column="1" Text="{Binding SelectedItem, ElementName=StageBox}" TextWrapping="Wrap" TextAlignment="Right" FontWeight="SemiBold" /></Grid>
     <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Itens" Foreground="{DynamicResource Muted}" Margin="0,0,10,0" /><TextBlock x:Name="AsideItemsText" Grid.Column="1" TextAlignment="Right" FontWeight="SemiBold" /></Grid>
     <!-- Custo e margem (informativo): os mesmos valores da aba Custo; "Ajustar custo" abre essa aba. -->
     <Border Background="{DynamicResource KindPedidoSoft}" CornerRadius="8" Padding="10,8,10,4" Margin="-10,10,-10,0"><StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Custo" Foreground="{DynamicResource Muted}" Margin="0,0,10,0" /><TextBlock x:Name="AsideCostText" Grid.Column="1" TextWrapping="Wrap" TextAlignment="Right" FontWeight="SemiBold" /></Grid>
      <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Margem" Foreground="{DynamicResource Muted}" Margin="0,0,10,0" /><TextBlock x:Name="AsideMarginText" Grid.Column="1" TextWrapping="Wrap" TextAlignment="Right" FontWeight="SemiBold" /></Grid>
      <Button x:Name="AsideAdjustCost" Content="Ajustar custo" Style="{StaticResource GhostButton}" FontSize="12.5" MinHeight="0" Padding="6,3" Margin="-6,4,0,0" HorizontalAlignment="Left" Foreground="{DynamicResource KindPedido}" Click="AdjustCost_Click" ToolTip="Abre a aba Custo (itens, frete, adicionais e conferência)" />
     </StackPanel></Border>
     <Separator Margin="0,8,0,8" />
     <StackPanel x:Name="AsideChecks" />
    </StackPanel></Border>
   </StackPanel>
  </local:DialogFrame.Aside>
  <local:DialogFrame.FooterLeft><StackPanel Orientation="Horizontal"><Button x:Name="FiscalButton" Content="Nota fiscal ▾" Style="{StaticResource SoftButton}" Click="Fiscal_Click" /><Button x:Name="ExtrasButton" Content="Retrabalho e terceiros" Style="{StaticResource SoftButton}" Margin="8,0,0,0" IsEnabled="False" Click="Extras_Click" /></StackPanel></local:DialogFrame.FooterLeft>
  <local:DialogFrame.Footer><StackPanel Orientation="Horizontal"><Button x:Name="CancelButton" Content="Cancelar" Style="{StaticResource GhostButton}" Click="Cancel_Click" ToolTip="Esc" /><Button x:Name="SaveButton" Content="Salvar pedido" Style="{StaticResource DialogPrimaryButton}" Margin="10,0,0,0" ToolTip="Ctrl+Enter ou Ctrl+S" Click="Save_Click" /></StackPanel></local:DialogFrame.Footer>
 <Grid><Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <TextBlock x:Name="TitleText" Text="Novo pedido" Visibility="Collapsed" />
  <TabControl x:Name="OrderTabs">
   <TabItem Tag="1" Header="Cliente e itens"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,4,0">
    <Border Style="{StaticResource Card}"><Grid x:Name="ClientGrid"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="2.3*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
     <StackPanel x:Name="ClientName"><TextBlock Text="Cliente" Style="{StaticResource FieldTitle}" /><Grid><TextBox x:Name="NameBox" LostFocus="NameBox_LostFocus" Tag="Nome do cliente (recentes aparecem ao digitar)" /><Button Width="36" Height="32" Margin="0,0,2,0" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource IconButtonSmall}" Tag="search" Click="LinkCustomer_Click" ToolTip="Pesquisar cliente cadastrado" /></Grid></StackPanel>
     <StackPanel x:Name="ClientPhone" Grid.Column="2"><TextBlock Text="Telefone / WhatsApp" Style="{StaticResource FieldTitle}" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="ContactBox" Tag="(11) 90000-0000" ToolTip="Telefone completo com DDD. Internacional: + código do país."><TextBox.ContextMenu><ContextMenu><MenuItem Header="Copiar telefone" Click="CopyContact_Click" /></ContextMenu></TextBox.ContextMenu></TextBox><local:WhatsAppButton x:Name="WhatsAppButton" Grid.Column="1" Compact="True" OpenOnClick="False" Phone="{Binding Text, ElementName=ContactBox}" Margin="8,0,0,0" VerticalAlignment="Center" Click="WhatsApp_Click" ToolTip="WhatsApp Desktop (modelos de mensagem)" /></Grid></StackPanel>
     <StackPanel x:Name="ClientDate" Grid.Column="4"><TextBlock Text="Data do pedido" Style="{StaticResource FieldTitle}" /><DatePicker x:Name="DebtOriginBox" /></StackPanel>
    </Grid></Border>
    <Border Style="{StaticResource Card}" Margin="0,10,0,0" MinHeight="145"><StackPanel>
     <Grid x:Name="ItemsHeader" Margin="0,0,0,10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="Itens do pedido" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" /><StackPanel x:Name="ItemActions" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="＋ Adicionar item" Style="{StaticResource OrderSoft}" Click="AddItem_Click" /><Button Content="＋ Novo produto" Style="{StaticResource OrderSoft}" Margin="8,0,0,0" Click="NewProduct_Click" /></StackPanel></Grid>
     <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="8" Padding="10,6" Margin="0,0,0,10"><Grid x:Name="ItemColumns"><Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="18" /><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition Width="160" /><ColumnDefinition Width="190" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions><TextBlock Text="Qtd." Foreground="{DynamicResource Muted}" FontWeight="SemiBold" FontSize="12.5" /><TextBlock Grid.Column="2" Text="Produto ou serviço" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" FontSize="12.5" /><TextBlock Grid.Column="4" Text="Unitário R$" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" FontSize="12.5" /><TextBlock Grid.Column="5" Text="Subtotal R$" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Center" /></Grid></Border>
     <StackPanel x:Name="ItemsStack" Margin="4,0,4,10" />
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,10,0,0"><Grid x:Name="CalculationGrid"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="340" /><ColumnDefinition /></Grid.ColumnDefinitions><Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left" VerticalAlignment="Center"><local:UiIcon IconName="calculator" Width="20" Height="20" Foreground="{DynamicResource AccentInk}" /></Border><StackPanel x:Name="CalculationMode" Grid.Column="1"><TextBlock Text="Cálculo dos itens" Style="{StaticResource FieldTitle}" /><ComboBox x:Name="PricingModeBox" SelectionChanged="PricingMode_Changed"><ComboBoxItem Content="Total manual — informar apenas o total" /><ComboBoxItem Content="Somar valores dos itens" /></ComboBox></StackPanel><TextBlock x:Name="ItemsTotalText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentInk}" /></Grid></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Tag="2" Header="Produção e prazo"><ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}"><StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Etapa atual" Style="{StaticResource FieldTitle}" /><ComboBox x:Name="StageBox" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Prazo de produção" Style="{StaticResource FieldTitle}" /><ComboBox x:Name="DeadlineBox" /></StackPanel></Grid>
    <Border Style="{StaticResource NoteCalm}" Margin="0,12,0,0"><DockPanel><local:UiIcon IconName="info" Width="16" Height="16" Foreground="{DynamicResource AccentInk}" Margin="0,1,8,0" VerticalAlignment="Top" /><TextBlock Text="Imediato usa a data do pedido. Os demais prazos começam em Aprovado. Se voltar para Arte ou Aguardando aprovação, a contagem para e a próxima aprovação inicia um novo prazo." FontSize="12.5" TextWrapping="Wrap" /></DockPanel></Border>
    <CheckBox x:Name="ProductionBox" Content="Material / serviço já encaminhado para produção" ToolTip="Registra a data de envio à produção ou ao fornecedor. Não confirma pagamento nem altera sozinho a etapa." FontWeight="SemiBold" Margin="0,14,0,0" />
    <TextBlock x:Name="NotesLabel" Text="Observações para a ficha" Style="{StaticResource FieldTitle}" Margin="0,14,0,6" /><TextBox x:Name="NotesBox" Height="72" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="0,9" Tag="Ex.: cliente retira às 17h; papel couché 300g" />
   </StackPanel></Border></ScrollViewer></TabItem>
   <TabItem Tag="3" Header="Valores e pagamentos"><ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="Valores do pedido" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="24" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Valor original (antes do desconto)" Style="{StaticResource FieldTitle}" /><TextBox x:Name="TotalBox" TextChanged="Totals_TextChanged" /><CheckBox x:Name="PricePendingBox" Content="Valor a definir — vou informar depois" Margin="0,8,0,0" Click="Pending_Click" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Tipo de desconto" Style="{StaticResource FieldTitle}" /><ComboBox x:Name="DiscountMode" SelectedIndex="0" SelectionChanged="DiscountMode_Changed"><ComboBoxItem Content="% Percentual" /><ComboBoxItem Content="R$ Valor" /></ComboBox><WrapPanel Margin="0,8,0,0"><TextBox x:Name="DiscountBox" Width="110" Text="0" TextChanged="Discount_Changed" /><Button Content="Aplicar desconto" Style="{StaticResource OrderSoft}" Margin="8,0,0,0" Click="ApplyDiscount_Click" /><Button Content="Remover" Style="{StaticResource OrderSoft}" Margin="8,0,0,0" Click="RemoveDiscount_Click" /></WrapPanel></StackPanel></Grid>
    <TextBlock x:Name="DiscountPreviewText" TextWrapping="Wrap" Margin="0,8,0,0" /><TextBlock x:Name="DiscountStateText" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="0,4,0,4" />
    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="{DynamicResource SurfaceAlt}" CornerRadius="10" Padding="16" Margin="0"><StackPanel><CheckBox x:Name="DepositPaidBox" Content="Sinal recebido" FontWeight="SemiBold" Click="PaymentCheck_Click" /><Grid Margin="24,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Valor recebido" Margin="0,0,0,7" /><TextBox x:Name="DepositBox" TextChanged="Totals_TextChanged" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Forma de pagamento" Margin="0,0,0,7" /><ComboBox x:Name="DepositPaymentBox" /></StackPanel></Grid></StackPanel></Border><Border Background="{DynamicResource SurfaceAlt}" CornerRadius="10" Padding="16" Margin="0" Grid.Column="2"><StackPanel><CheckBox x:Name="FullyPaidBox" Content="Pagamento total recebido" FontWeight="SemiBold" Click="PaymentCheck_Click" /><Grid Margin="24,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Dia em que pagou" Margin="0,0,0,7" /><DatePicker x:Name="FinalPaymentDateBox" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Forma do pagamento final" Margin="0,0,0,7" /><ComboBox x:Name="FinalPaymentBox" /></StackPanel></Grid><CheckBox x:Name="PayAfterDeliveryBox" Content="Manter saldo em aberto — receber depois" FontWeight="SemiBold" Margin="24,15,0,0" Click="PaymentCheck_Click" /><StackPanel Margin="24,10,0,0"><TextBlock Text="Previsão de pagamento (opcional)" Margin="0,0,0,6" /><DatePicker x:Name="ExpectedPaymentDateBox" Width="210" HorizontalAlignment="Left" /></StackPanel></StackPanel></Border></Grid>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0"><StackPanel x:Name="MixedPaymentsHost" /></Border>
    <StackPanel x:Name="ExistingPaymentsHost" Margin="0,8,0,0" /><TextBlock x:Name="PaymentFeesText" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" />
    <Border x:Name="CorrectionPanel" Background="{DynamicResource SurfaceAlt}" CornerRadius="10" Padding="16" Margin="0,10,0,0"><StackPanel><CheckBox x:Name="AdjustRecordedPaymentBox" Click="PaymentCheck_Click" Content="Corrigir um pagamento já registrado" FontWeight="SemiBold" /><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions><ComboBox x:Name="ExistingPaymentBox" DisplayMemberPath="Label" SelectionChanged="PaymentChoice_Changed" /><TextBox Grid.Column="2" x:Name="ExistingPaymentAmountBox" TextChanged="Totals_TextChanged" /></Grid><TextBlock Text="Forma corrigida (crédito inclui parcelas)" Margin="0,10,0,6" /><ComboBox x:Name="CorrectionTypeBox" /><TextBlock Text="Justificativa obrigatória" Margin="0,12,0,6" /><TextBox x:Name="CorrectionReasonBox" MinHeight="54" TextWrapping="Wrap" AcceptsReturn="True" /></StackPanel></Border>
   </StackPanel></Border></ScrollViewer></TabItem>
   <TabItem Tag="4" Header="Custo"><ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Custo de produção" Style="{StaticResource SectionTitle}" /><TextBlock Text="Informe os gastos deste pedido. Custos são controles internos e não aparecem no recibo do cliente. Custo vazio fica como pendente — nunca como zero nos relatórios." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,4,0,10" /><Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="150" /><ColumnDefinition Width="170" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions><TextBlock Text="Qtd./item" Style="{StaticResource FieldTitle}" /><TextBlock Grid.Column="1" Text="Custo unit." Style="{StaticResource FieldTitle}" /><TextBlock Grid.Column="2" Text="Custo total" Style="{StaticResource FieldTitle}" Margin="10,0,0,6" /><TextBlock Grid.Column="3" Text="Status" Style="{StaticResource FieldTitle}" /></Grid><StackPanel x:Name="CostItemsStack" /><DockPanel><CheckBox x:Name="IgnoreCostsBox" Content="Ignorar apuração deste pedido" Click="IgnoreCosts_Click" Margin="0,6,0,0" DockPanel.Dock="Right" /><TextBlock x:Name="ItemsCostText" Margin="0,6,0,0" FontWeight="SemiBold" /></DockPanel><TextBlock x:Name="CostSaleText" Margin="0,6,0,0" /><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><StackPanel x:Name="CostReasonPanel" Margin="0,0,0,8"><TextBlock Text="Motivo da correção (pedido concluído)" Style="{StaticResource FieldTitle}" Margin="0,0,0,4" /><TextBox x:Name="CostReasonBox" /></StackPanel><TextBlock Text="Detalhes / fornecedor" Style="{StaticResource FieldTitle}" Margin="0,0,0,4" /><TextBox x:Name="CostNotesBox" Height="50" AcceptsReturn="True" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Column="2"><Grid Margin="0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Frete / Uber para retirada (R$)" Style="{StaticResource FieldTitle}" /><TextBox x:Name="FreightCostBox" TextChanged="Totals_TextChanged" /></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="Custo adicional (R$)" Style="{StaticResource FieldTitle}" /><TextBox x:Name="AdditionalCostBox" TextChanged="Totals_TextChanged" /></StackPanel>
    </Grid><Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="12,10" Margin="0,10,0,0"><UniformGrid Columns="3">
     <StackPanel><TextBlock Text="Custo total" Foreground="{DynamicResource Muted}" FontSize="12" /><TextBlock x:Name="CostTotalText" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="CostPartialText" Text="Parcial: há itens sem custo" FontSize="11.5" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" Visibility="Collapsed" /></StackPanel>
     <StackPanel><TextBlock Text="Lucro do pedido" Foreground="{DynamicResource Muted}" FontSize="12" /><TextBlock x:Name="ProfitText" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentInk}" /></StackPanel>
     <StackPanel><TextBlock Text="Margem sobre venda" Foreground="{DynamicResource Muted}" FontSize="12" /><TextBlock x:Name="MarginText" FontSize="18" FontWeight="SemiBold" /></StackPanel>
    </UniformGrid></Border><TextBlock Text="Lucro = venda final − (itens + frete + adicionais). Revise cada item, inclusive custo zero. Pendente e Ignorado não possuem lucro apurado." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" FontSize="12" /></StackPanel></Grid></StackPanel></Border></ScrollViewer></TabItem>
  </TabControl>
  <!-- Faixa de totais: usada quando a janela é estreita e o resumo lateral fica oculto. -->
