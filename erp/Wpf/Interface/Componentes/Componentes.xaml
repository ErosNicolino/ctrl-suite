<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GraficaCaixa.Wpf">
 <!-- Componentes UX 2.0 (pacote 1). Medidas do protótipo erp-prototipo.html; cores só por DynamicResource (ThemeManager). -->
 <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

 <!-- Painel (.panel): superfície, borda 1 px, raio 12. -->
 <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/></Style>
 <!-- Resumo ao vivo (.recibo): borda superior de 4 px na cor do contexto, raio 16, sombra suave. -->
 <Style x:Key="SummaryCard" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="18"/><Setter Property="BorderThickness" Value="0,4,0,0"/><Setter Property="BorderBrush" Value="{Binding Path=(local:Ui.Accent),RelativeSource={RelativeSource Self}}"/><Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity=".10"/></Setter.Value></Setter></Style>
 <Style x:Key="SummaryValue" TargetType="TextBlock"><Setter Property="FontSize" Value="32"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{Binding Path=(local:Ui.Accent),RelativeSource={RelativeSource Self}}"/></Style>
 <!-- Aviso em linha (.note): âmbar; "Calm" em verde suave. -->
 <Style x:Key="Note" TargetType="Border"><Setter Property="Background" Value="{DynamicResource WarningSoft}"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="12,9"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Warning}"/></Style>
 <Style x:Key="NoteCalm" TargetType="Border" BasedOn="{StaticResource Note}"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource AccentInk}"/></Style>
 <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12.8"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
 <Style x:Key="FieldError" TargetType="TextBlock"><Setter Property="FontSize" Value="12.5"/><Setter Property="Margin" Value="0,4,0,0"/><Setter Property="Foreground" Value="{DynamicResource Danger}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <!-- UX 2.0 (pacote 4): barra superior — campo da busca Ctrl+K e "chips" (caixa, usuário). -->
 <Style x:Key="CommandBarButton" TargetType="Button"><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="14,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRingVisual}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="B" Property="Background" Value="{DynamicResource Surface}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="TopChip" TargetType="Button"><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="14,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontSize" Value="13"/><Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRingVisual}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="20" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Hover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <!-- UX 2.0 (pacote 5): indicadores do Início (raio 12, faixa de cor no topo que acompanha o canto: KpiCap). -->
 <Style x:Key="KpiTile" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="16,13,16,12"/></Style>
 <!-- Faixa de cor dos cartões de indicador (igual ao Início): fica atrás do cartão, que desce 4 px, e acompanha o canto arredondado. Use com KpiCapTile. --><Style x:Key="KpiCap" TargetType="Border"><Setter Property="Height" Value="16"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="CornerRadius" Value="12,12,0,0"/><Setter Property="IsHitTestVisible" Value="False"/></Style><Style x:Key="KpiCapTile" TargetType="Border" BasedOn="{StaticResource KpiTile}"><Setter Property="Margin" Value="0,4,0,0"/></Style>
 <Style x:Key="KpiLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12.8"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
 <Style x:Key="Kbd" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1,1,1,2"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="5,0"/><Setter Property="Margin" Value="2,0"/><Setter Property="TextElement.FontSize" Value="11"/><Setter Property="TextElement.FontWeight" Value="SemiBold"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Muted}"/></Style>

 <!-- Chip (filtro/atalho): pílula de 34 px; pressionado em verde suave. -->
 <Style x:Key="Chip" TargetType="ToggleButton"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13.4"/><Setter Property="Padding" Value="12,0"/><Setter Property="Height" Value="34"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="17" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="Background" Value="{Binding Path=(local:Ui.AccentSoft),RelativeSource={RelativeSource TemplatedParent}}"/><Setter TargetName="B" Property="BorderBrush" Value="{Binding Path=(local:Ui.Accent),RelativeSource={RelativeSource TemplatedParent}}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="B" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <!-- Segmentado (.seg): barra cinza com botões; o escolhido fica em superfície com sombra. Use RadioButtons com o mesmo GroupName. -->
 <Style x:Key="SegmentBar" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="3"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
 <Style x:Key="Segment" TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="12,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="B" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="1,0"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter TargetName="B" Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity=".14"/></Setter.Value></Setter></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="B" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <!-- Interruptor (liga/desliga) para CheckBox. -->
 <Style x:Key="Switch" TargetType="CheckBox"><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal" Background="Transparent"><Grid Width="42" Height="24" VerticalAlignment="Center"><Border x:Name="Track" CornerRadius="12" Background="{DynamicResource Line}"/><Border x:Name="Knob" Width="18" Height="18" CornerRadius="9" Background="White" HorizontalAlignment="Left" Margin="3,0"><Border.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity=".25"/></Border.Effect></Border></Grid><ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

 <!-- Diálogo central. -->
 <Style TargetType="local:DialogFrame"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:DialogFrame">
  <Border Background="{TemplateBinding Background}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <!-- Cabeçalho: degradê da cor do tipo para a superfície, faixa de 5 px, selo 46 px, título e subtítulo. -->
   <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,.55"><GradientStop Color="{Binding Band.Color,RelativeSource={RelativeSource TemplatedParent}}" Offset="0"/><GradientStop Color="{DynamicResource SurfaceColor}" Offset=".75"/></LinearGradientBrush></Border.Background>
    <Grid><Border Height="5" VerticalAlignment="Top" Background="{Binding Path=(local:Ui.Accent),RelativeSource={RelativeSource TemplatedParent}}"/>
     <Grid Margin="24,21,18,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="46" Height="46" CornerRadius="13" Background="{Binding Path=(local:Ui.Accent),RelativeSource={RelativeSource TemplatedParent}}" Margin="0,0,14,0" Visibility="{Binding IconName,RelativeSource={RelativeSource TemplatedParent},Converter={x:Static local:EmptyToCollapsed.Instance}}"><local:UiIcon IconName="{TemplateBinding IconName}" Width="24" Height="24" Foreground="{DynamicResource OnK}" Plain="True"/></Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{TemplateBinding Title}" FontFamily="Segoe UI Semibold" FontSize="22" TextTrimming="CharacterEllipsis"/><TextBlock Text="{TemplateBinding Subtitle}" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="{Binding Subtitle,RelativeSource={RelativeSource TemplatedParent},Converter={x:Static local:EmptyToCollapsed.Instance}}"/></StackPanel>
      <ContentPresenter Grid.Column="2" Content="{TemplateBinding HeaderExtra}" VerticalAlignment="Center" Margin="12,0,0,0"/>
      <Button x:Name="PART_Close" Grid.Column="3" Style="{DynamicResource IconButton}" Tag="x" ToolTip="Fechar (Esc)" Margin="8,0,0,0" VerticalAlignment="Center" IsTabStop="False" Visibility="{TemplateBinding ShowClose,Converter={StaticResource BoolToVisibility}}"/>
     </Grid></Grid></Border>
   <!-- Corpo: formulário rolável + resumo (opcional) em fundo suave. -->
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ScrollViewer x:Name="BodyScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"><ContentPresenter Margin="24,18,24,18"/></ScrollViewer>
    <Border x:Name="AsideHost" Grid.Column="1" Width="{TemplateBinding AsideWidth}" Background="{Binding Path=(local:Ui.AccentSoft),RelativeSource={RelativeSource TemplatedParent}}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"><ContentPresenter Content="{TemplateBinding Aside}" Margin="22,20"/></ScrollViewer></Border>
   </Grid>
   <!-- Rodapé fixo: à esquerda informações (totais), à direita Cancelar + ação principal. -->
   <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource Surface}" Padding="24,12"><Grid><ContentPresenter Content="{TemplateBinding FooterLeft}" HorizontalAlignment="Left" VerticalAlignment="Center"/><ContentPresenter Content="{TemplateBinding Footer}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
  </Grid></Border>
  <ControlTemplate.Triggers><Trigger Property="Aside" Value="{x:Null}"><Setter TargetName="AsideHost" Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="ScrollBody" Value="False"><Setter TargetName="BodyScroll" Property="VerticalScrollBarVisibility" Value="Disabled"/></Trigger></ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter></Style>

 <!-- Seção numerada. -->
 <Style TargetType="local:SectionCard"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:SectionCard">
  <Grid><Border x:Name="Ring" Margin="-3" CornerRadius="17" BorderThickness="3" Visibility="Collapsed" BorderBrush="{Binding Path=(local:Ui.AccentSoft),RelativeSource={RelativeSource TemplatedParent}}"/>
   <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16,14"><StackPanel>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border x:Name="Num" Width="26" Height="26" CornerRadius="13" Margin="0,0,10,0" Background="{Binding Path=(local:Ui.AccentSoft),RelativeSource={RelativeSource TemplatedParent}}" Visibility="{Binding Number,RelativeSource={RelativeSource TemplatedParent},Converter={x:Static local:EmptyToCollapsed.Instance}}"><Grid><TextBlock x:Name="NumText" Text="{TemplateBinding Number}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Path=(local:Ui.Accent),RelativeSource={RelativeSource TemplatedParent}}"/><local:UiIcon x:Name="Done" IconName="check" Width="14" Height="14" StrokeWidth="2.6" Foreground="{DynamicResource OnK}" Visibility="Collapsed"/></Grid></Border>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="{TemplateBinding Hint}" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel>
     <ContentPresenter Grid.Column="2" Content="{TemplateBinding HeaderTools}" VerticalAlignment="Center"/>
    </Grid>
    <ContentPresenter/>
   </StackPanel></Border></Grid>
  <ControlTemplate.Triggers><Trigger Property="IsDone" Value="True"><Setter TargetName="Num" Property="Background" Value="{Binding Path=(local:Ui.Accent),RelativeSource={RelativeSource TemplatedParent}}"/><Setter TargetName="NumText" Property="Visibility" Value="Collapsed"/><Setter TargetName="Done" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{Binding Path=(local:Ui.Accent),RelativeSource={RelativeSource TemplatedParent}}"/><Setter TargetName="Ring" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsOptional" Value="True"><Setter TargetName="Box" Property="Background" Value="Transparent"/></Trigger></ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter></Style>

 <!-- KPI: faixa de cor no topo (igual ao Início), rótulo, valor grande e dica; esqueleto enquanto carrega. -->
 <Style TargetType="local:KpiCard"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:KpiCard">
  <Grid><Border Height="16" VerticalAlignment="Top" CornerRadius="12,12,0,0" Background="{TemplateBinding Stripe}" IsHitTestVisible="False"/><Border x:Name="Tile" Margin="0,4,0,0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12"><StackPanel>
    <TextBlock Text="{TemplateBinding Label}" FontSize="12.8" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
    <Grid Margin="0,4,0,0"><TextBlock x:Name="Val" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/><local:Skeleton x:Name="Sk" Height="26" Width="120" HorizontalAlignment="Left" Visibility="Collapsed"/></Grid>
    <TextBlock x:Name="HintLine" Text="{TemplateBinding Hint}" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{TemplateBinding Hint}" Visibility="{Binding Hint,RelativeSource={RelativeSource TemplatedParent},Converter={x:Static local:EmptyToCollapsed.Instance}}"/>
   </StackPanel></Border></Grid>
  <ControlTemplate.Triggers><Trigger Property="IsHero" Value="True"><Setter TargetName="Val" Property="FontSize" Value="30"/></Trigger><Trigger Property="IsCompact" Value="True"><Setter TargetName="Tile" Property="Padding" Value="14,6"/><Setter TargetName="Val" Property="FontSize" Value="19"/><Setter TargetName="HintLine" Property="Visibility" Value="Collapsed"/><Setter TargetName="Tile" Property="ToolTip" Value="{Binding Hint,RelativeSource={RelativeSource TemplatedParent}}"/></Trigger><Trigger Property="IsLoading" Value="True"><Setter TargetName="Val" Property="Visibility" Value="Hidden"/><Setter TargetName="Sk" Property="Visibility" Value="Visible"/></Trigger><DataTrigger Binding="{Binding ValueBrush,RelativeSource={RelativeSource TemplatedParent},Converter={x:Static local:NullToFalse.Instance}}" Value="True"><Setter TargetName="Val" Property="Foreground" Value="{Binding ValueBrush,RelativeSource={RelativeSource TemplatedParent}}"/></DataTrigger></ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter></Style>

 <Style TargetType="local:StatusTag"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:StatusTag">
  <Border Background="{TemplateBinding Background}" CornerRadius="6" Height="24" Padding="8,0" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:UiIcon IconName="{TemplateBinding IconName}" Width="13" Height="13" Foreground="{TemplateBinding Foreground}" Margin="0,0,5,0" Visibility="{Binding IconName,RelativeSource={RelativeSource TemplatedParent},Converter={x:Static local:EmptyToCollapsed.Instance}}"/><TextBlock Text="{TemplateBinding Text}" FontSize="12" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/></StackPanel></Border>
 </ControlTemplate></Setter.Value></Setter></Style>

 <Style TargetType="local:EmptyState"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:EmptyState">
  <StackPanel Margin="16,36" MaxWidth="440"><local:UiIcon IconName="{TemplateBinding IconName}" Width="34" Height="34" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/><TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap"/><TextBlock Text="{TemplateBinding Hint}" Foreground="{DynamicResource Muted}" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/><Button x:Name="PART_Action" Content="{TemplateBinding ActionText}" Style="{DynamicResource SmallButton}" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="{Binding ActionText,RelativeSource={RelativeSource TemplatedParent},Converter={x:Static local:EmptyToCollapsed.Instance}}"/></StackPanel>
 </ControlTemplate></Setter.Value></Setter></Style>

 <Style TargetType="local:Skeleton"><Setter Property="Height" Value="14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:Skeleton"><Border Background="{DynamicResource SurfaceAlt}" CornerRadius="6"/></ControlTemplate></Setter.Value></Setter></Style>

 <Style TargetType="local:ViewToggle"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:ViewToggle">
  <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="10" Padding="3"><StackPanel Orientation="Horizontal">
   <ToggleButton x:Name="PART_List" ToolTip="Ver em lista" IsChecked="{Binding Mode,RelativeSource={RelativeSource TemplatedParent},Converter={x:Static local:EqualsConverter.Instance},ConverterParameter=Lista,Mode=OneWay}"><StackPanel Orientation="Horizontal"><local:UiIcon IconName="list" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock Text="Lista"/></StackPanel></ToggleButton>
   <ToggleButton x:Name="PART_Cards" ToolTip="{Binding SecondLabel,RelativeSource={RelativeSource TemplatedParent},StringFormat=Ver em {0}}" IsChecked="{Binding Mode,RelativeSource={RelativeSource TemplatedParent},Converter={x:Static local:EqualsConverter.Instance},ConverterParameter=Cards,Mode=OneWay}"><StackPanel Orientation="Horizontal"><local:UiIcon IconName="{Binding SecondIcon,RelativeSource={RelativeSource TemplatedParent}}" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock Text="{Binding SecondLabel,RelativeSource={RelativeSource TemplatedParent}}"/></StackPanel></ToggleButton>
  </StackPanel></Border>
  <ControlTemplate.Resources><Style TargetType="ToggleButton"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="11,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="B" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="1,0"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter TargetName="B" Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity=".14"/></Setter.Value></Setter></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="B" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ControlTemplate.Resources>
 </ControlTemplate></Setter.Value></Setter></Style>

 <!-- WhatsApp: pílula verde de 36 px (ícone + texto); compacto = só ícone 28×28; incompleto = cinza tracejado. -->
 <Style TargetType="local:WhatsAppButton"><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13.4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:WhatsAppButton">
  <Border x:Name="B" Background="{DynamicResource Wa}" CornerRadius="18" Height="36" Padding="12,0" BorderThickness="1" BorderBrush="Transparent"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"><local:UiIcon x:Name="Ic" IconName="whatsapp" Plain="True" Width="17" Height="17" Foreground="White"/><TextBlock x:Name="Tx" Text="{TemplateBinding Content}" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></Border>
  <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value=".9"/></Trigger><Trigger Property="Compact" Value="True"><Setter TargetName="B" Property="Width" Value="28"/><Setter TargetName="B" Property="Height" Value="28"/><Setter TargetName="B" Property="Padding" Value="0"/><Setter TargetName="Tx" Property="Visibility" Value="Collapsed"/><Setter TargetName="Ic" Property="Width" Value="15"/><Setter TargetName="Ic" Property="Height" Value="15"/></Trigger><Trigger Property="IsComplete" Value="False"><Setter TargetName="B" Property="Background" Value="{DynamicResource SurfaceAlt}"/><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Line}"/><Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource Muted}"/><Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource Muted}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="B" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
