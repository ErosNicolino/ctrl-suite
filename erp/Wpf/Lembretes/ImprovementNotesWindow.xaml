<Window x:Class="GraficaCaixa.Wpf.ImprovementNotesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Caderno de melhorias" Width="820" Height="660" MinWidth="600" MinHeight="460" WindowStartupLocation="CenterOwner" Icon="/Assets/icon.ico">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel Margin="0,0,0,20"><TextBlock Text="Caderno de melhorias" Style="{StaticResource Title}"/><TextBlock Text="Guarde ideias, ajustes e lembretes para melhorar o programa." Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel>
 <TextBox x:Name="Editor" Grid.Row="1" Style="{x:Null}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="18" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" FontSize="15" BorderBrush="{DynamicResource Line}" BorderThickness="1" TextChanged="Editor_Changed"/><TextBlock Grid.Row="1" Margin="22,20,22,0" IsHitTestVisible="False" TextWrapping="Wrap" FontSize="15" Foreground="{DynamicResource Muted}" Text="Escreva aqui ideias e ajustes para o programa, um por linha. Ex.: &quot;Mostrar o saldo do cliente no recibo&quot;."><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Editor}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
 <DockPanel Grid.Row="2" Margin="0,16,0,0"><Button DockPanel.Dock="Right" Content="Salvar anotações" Style="{StaticResource PrimaryButton}" Click="Save_Click"/><TextBlock x:Name="Status" Text="Suas anotações são salvas automaticamente." Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
 </Grid>
</Window>
