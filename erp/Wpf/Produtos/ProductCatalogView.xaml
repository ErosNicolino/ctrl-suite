<UserControl x:Class="GraficaCaixa.Wpf.ProductCatalogView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource AccentSoft}" CornerRadius="12" Padding="18,14" Margin="0,0,0,16">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Preços à mão, sem abrir arquivos" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
     <TextBlock Text="Escolha uma categoria ou pesquise um produto, material ou tamanho." Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
    <TextBlock Grid.Column="1" Text="Tabela da gráfica" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" FontSize="11" Margin="20,0,0,0"/>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="250"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Pesquisar produto" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBox x:Name="SearchBox" ToolTip="Ex.: cartão de visita, caneca, 300g" TextChanged="Filter_Changed" AutomationProperties.Name="Pesquisar produto"/></StackPanel>
   <StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="Categoria" FontWeight="SemiBold" Margin="0,0,0,6"/><ComboBox x:Name="CategoryBox" SelectionChanged="Filter_Changed" AutomationProperties.Name="Categoria"/></StackPanel>
   <Button Grid.Column="2" Content="Limpar" Style="{StaticResource SoftButton}" VerticalAlignment="Bottom" Height="42" Margin="12,0,0,0" Click="Clear_Click"/>
  </Grid>
  <Grid Grid.Row="2">
   <Grid x:Name="CategoriesPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,12"><TextBlock Text="O que você quer consultar?" Style="{StaticResource SectionTitle}"/><Button Content="Ver todos os produtos →" Style="{StaticResource SoftButton}" HorizontalAlignment="Right" Click="All_Click"/></Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <ItemsControl x:Name="CategoryCards"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Button Tag="{Binding Name}" Click="Category_Click" Width="268" Height="126" Margin="0,0,14,14" Cursor="Hand" AutomationProperties.Name="{Binding Name}">
        <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Tile" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="20">
         <ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource AccentSoft}"/><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Tile" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
        <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,18,8"/><TextBlock Grid.Row="1" Text="{Binding CountText}" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock Grid.Row="1" Text="→" HorizontalAlignment="Right" Foreground="{DynamicResource Accent}" FontSize="17"/></Grid>
       </Button>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
   </Grid>
   <Grid x:Name="ProductsPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="BackButton" Content="← Categorias" Style="{StaticResource SoftButton}" Click="Back_Click" Margin="0,0,14,0"/>
     <TextBlock x:Name="ListTitle" Grid.Column="1" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/><TextBlock x:Name="CountText" Grid.Column="2" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8"><Grid>
     <DataGrid x:Name="ProductsGrid" RowHeight="NaN" MinRowHeight="74" SelectionChanged="Product_Selected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <DataGrid.Resources><Style x:Key="Wrap" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,12"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
       <Style x:Key="PriceHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="HorizontalContentAlignment" Value="Right"/></Style>
      </DataGrid.Resources>
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="Produto / acabamento" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="0,12"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="Referência do preço" Binding="{Binding Basis}" Width="165" ElementStyle="{StaticResource Wrap}"/>
       <DataGridTemplateColumn Header="Valor da tabela" Width="225" HeaderStyle="{StaticResource PriceHeader}"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="0,10"><TextBlock Text="{Binding PriceText}" TextAlignment="Right" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/><TextBlock Text="{Binding StatusText}" TextAlignment="Right" TextWrapping="Wrap" FontSize="11" Foreground="{Binding StatusColor}" Margin="0,4,0,0"/><TextBlock Text="{Binding SourceSheet}" TextAlignment="Right" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
     <TextBlock x:Name="EmptyText" Text="Nenhum produto encontrado. Tente outro nome ou limpe os filtros." Visibility="Collapsed" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="20"/>
    </Grid></Border>
    <Border Grid.Row="2" Background="{DynamicResource SurfaceAlt}" CornerRadius="10" Padding="14,10" Margin="0,12,0,0"><ScrollViewer MaxHeight="112" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="DetailsText" Text="Selecione uma opção para conferir suas observações." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" LineHeight="18"/></ScrollViewer></Border>
   </Grid>
  </Grid>
  <WrapPanel Grid.Row="3" Margin="0,12,0,0"><Button Content="Copiar Resumo" Style="{StaticResource PrimaryButton}" Click="Copy_Click"/><Button Content="Criar pedido com produto" Style="{StaticResource SoftButton}" Margin="10,0" Click="Order_Click"/><TextBlock Text="Fonte: Cadastro de Produtos • preços de venda" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/></WrapPanel>
 </Grid>
</UserControl>
