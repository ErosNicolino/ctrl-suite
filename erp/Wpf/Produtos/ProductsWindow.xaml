<Window x:Class="GraficaCaixa.Wpf.ProductsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GraficaCaixa.Wpf" Title="Produtos e serviços" Width="1100" Height="720" MinWidth="860" MinHeight="560" WindowStartupLocation="CenterOwner" Icon="/Assets/icon.ico">
 <Window.Resources>
  <local:ProductCardText x:Key="CardText"/><local:CardColumns x:Key="CardColumns"/>
  <Style x:Key="ProductItem" TargetType="ListBoxItem">
   <Setter Property="Margin" Value="0,0,12,12"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Card" Height="180" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="15,13" Cursor="Hand"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource KindProduto}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource KindProduto}"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/><Setter TargetName="Card" Property="Background" Value="{DynamicResource KindProdutoSoft}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="ProductCard">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel>
     <Border DockPanel.Dock="Right" Visibility="{Binding Converter={StaticResource CardText},ConverterParameter=inactive}" Background="{DynamicResource SurfaceAlt}" CornerRadius="8" Padding="7,1" Margin="6,0,0,0"><TextBlock Text="Inativo" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/></Border>
     <StackPanel Orientation="Horizontal"><Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource KindProduto}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{Binding Category}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/></StackPanel>
    </DockPanel>
    <DockPanel Grid.Row="1" Margin="0,6,0,6">
     <Border DockPanel.Dock="Right" Width="64" Height="64" CornerRadius="8" Margin="10,0,0,0" VerticalAlignment="Top" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" ClipToBounds="True">
      <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding PhotoPath}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding PhotoPath}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
      <Image local:ProductThumb.Product="{Binding}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Foto do produto"/>
     </Border>
     <TextBlock Text="{Binding Description}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="58" ToolTip="{Binding Description}"/>
    </DockPanel>
    <StackPanel Grid.Row="2" ToolTip="{Binding Converter={StaticResource CardText},ConverterParameter=table}">
     <WrapPanel><TextBlock Text="{Binding Converter={StaticResource CardText},ConverterParameter=price}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding Converter={StaticResource CardText},ConverterParameter=basis}" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Bottom" Margin="6,0,0,3"/></WrapPanel>
     <StackPanel Visibility="{Binding Converter={StaticResource CardText},ConverterParameter=costVisible}"><TextBlock Text="{Binding Converter={StaticResource CardText},ConverterParameter=cost}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Converter={StaticResource CardText},ConverterParameter=cost}"/><Border Width="120" Height="5" CornerRadius="2.5" HorizontalAlignment="Left" Margin="0,4,0,0" Background="{DynamicResource Line}"><Border HorizontalAlignment="Left" CornerRadius="2.5" Width="{Binding Converter={StaticResource CardText},ConverterParameter=marginWidth}" Background="{Binding Converter={StaticResource CardText},ConverterParameter=marginBrush}"/></Border></StackPanel><Border Visibility="{Binding Converter={StaticResource CardText},ConverterParameter=noCostVisible}" Background="{DynamicResource WarningSoft}" CornerRadius="6" Padding="7,2" Margin="0,4,0,0" HorizontalAlignment="Left" ToolTip="Abra o produto e informe o custo (aba Custos, ou nas faixas / quantidades exatas)"><TextBlock Text="⚠ Sem custo · informar" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Warning}"/></Border>
    </StackPanel>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="ProductList"><Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="145"/><ColumnDefinition Width="230"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding Description}"/><TextBlock Grid.Column="1" Text="{Binding Category}" TextWrapping="Wrap" Margin="12,0"/><TextBlock Grid.Column="2" Text="{Binding Converter={StaticResource CardText},ConverterParameter=price}" ToolTip="{Binding Converter={StaticResource CardText},ConverterParameter=table}"/><StackPanel Grid.Column="3"><StackPanel Visibility="{Binding Converter={StaticResource CardText},ConverterParameter=costVisible}"><TextBlock Text="{Binding Converter={StaticResource CardText},ConverterParameter=cost}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Converter={StaticResource CardText},ConverterParameter=cost}"/><Border Width="120" Height="5" CornerRadius="2.5" HorizontalAlignment="Left" Margin="0,4,0,0" Background="{DynamicResource Line}"><Border HorizontalAlignment="Left" CornerRadius="2.5" Width="{Binding Converter={StaticResource CardText},ConverterParameter=marginWidth}" Background="{Binding Converter={StaticResource CardText},ConverterParameter=marginBrush}"/></Border></StackPanel><Border Visibility="{Binding Converter={StaticResource CardText},ConverterParameter=noCostVisible}" Background="{DynamicResource WarningSoft}" CornerRadius="6" Padding="7,2" Margin="0,4,0,0" HorizontalAlignment="Left" ToolTip="Abra o produto e informe o custo (aba Custos, ou nas faixas / quantidades exatas)"><TextBlock Text="⚠ Sem custo · informar" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Warning}"/></Border></StackPanel><TextBlock Grid.Column="4"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Ativo"/><Style.Triggers><DataTrigger Binding="{Binding Active}" Value="False"><Setter Property="Text" Value="Inativo"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border></DataTemplate>
  <ItemsPanelTemplate x:Key="ProductListPanel"><StackPanel/></ItemsPanelTemplate>
  <Style x:Key="ProductListItem" TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style>
 </Window.Resources>
 <Grid Margin="24,22,24,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Catálogo" Click="Catalog_Click" Style="{StaticResource SoftButton}" Margin="0,0,8,0" ToolTip="Gerar catálogo com fotos e preços (PDF e imagens) para enviar pelo WhatsApp"/><Button Content="Categorias" Click="Categories_Click" Style="{StaticResource SoftButton}"/><Button Content="＋ Novo produto" Click="New_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" ToolTip="Cadastrar produto ou serviço"/></StackPanel>
   <StackPanel><TextBlock Text="Produtos e serviços" Style="{StaticResource Title}"/><TextBlock Text="Preços de venda, tabelas por quantidade e custos · dois cliques ou Enter para editar" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel>
  </DockPanel>
  <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="250"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="SearchBox" local:SearchShortcut.IsTarget="True" TextChanged="Search_Changed" ToolTip="Pesquise por qualquer palavra da descrição" Tag="Pesquisar produto ou serviço…" AutomationProperties.Name="Pesquisar produto ou serviço"/>
   <ComboBox Grid.Column="1" x:Name="CategoryBox" Margin="12,0,0,0" SelectionChanged="Search_Changed" AutomationProperties.Name="Filtrar por categoria"/>
   <CheckBox Grid.Column="2" x:Name="InactiveBox" Content="Incluir inativos" Margin="14,0,0,0" VerticalAlignment="Center" Click="Search_Changed"/><CheckBox Grid.Column="3" x:Name="NoCostBox" Content="Só sem custo" ToolTip="Mostra só os produtos sem custo cadastrado (nem padrão, nem nas faixas / quantidades exatas) para completar" Margin="14,0,0,0" VerticalAlignment="Center" Click="Search_Changed"/>
  </Grid>
  <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12" MinHeight="40"><local:ViewToggle x:Name="ProductsView" Mode="Cards" StorageKey="produtos" Margin="0,0,16,0" VerticalAlignment="Center"/><Button x:Name="CreateOrderButton" Content="Criar pedido" Click="CreateOrder_Click" Style="{StaticResource PrimaryButton}" IsEnabled="False"/><Button x:Name="EditProductButton" Content="Editar" Click="Edit_Click" Style="{StaticResource SoftButton}" Margin="8,0,0,0" IsEnabled="False"/><Button x:Name="ToggleProductButton" Content="Ativar / inativar" Click="Toggle_Click" Style="{StaticResource SoftButton}" Margin="8,0,0,0" IsEnabled="False"/><Button x:Name="DeleteProductButton" Content="Excluir" Click="Delete_Click" Style="{StaticResource DangerCompactButton}" Margin="8,0,0,0" IsEnabled="False"/></StackPanel>
  <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Border x:Name="ListHeaders" Visibility="Collapsed" Background="{DynamicResource SurfaceAlt}" CornerRadius="10,10,0,0" Padding="12,9" Margin="0,0,0,0" TextElement.Foreground="{DynamicResource Muted}" TextElement.FontSize="12.5" TextElement.FontWeight="SemiBold"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="145"/><ColumnDefinition Width="230"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock Text="Descrição" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Categoria" Margin="12,0"/><TextBlock Grid.Column="2" Text="Venda"/><TextBlock Grid.Column="3" Text="Custo e margem"/><TextBlock Grid.Column="4" Text="Status"/></Grid></Border>
  <ListBox Grid.Row="1" x:Name="ProductsGrid" ItemTemplate="{StaticResource ProductCard}" ItemContainerStyle="{StaticResource ProductItem}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="Product_DoubleClick" SelectionChanged="Product_SelectionChanged">
   <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid VerticalAlignment="Top" Columns="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=ScrollViewer},Converter={StaticResource CardColumns},ConverterParameter=286}"/></ItemsPanelTemplate></ListBox.ItemsPanel>
  </ListBox></Grid>
  <Grid Grid.Row="4" Margin="0,10,0,0"><TextBlock Text="Custo e margem são internos. Passe o mouse no preço para ver a tabela completa." Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/><TextBlock x:Name="ResultCountText" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}"/></Grid>
 </Grid>
</Window>
