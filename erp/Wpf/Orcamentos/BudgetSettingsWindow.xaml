<Window x:Class="GraficaCaixa.Wpf.BudgetSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Configurações do orçamento" Width="1180" Height="690" MinWidth="980" MinHeight="560" WindowStartupLocation="CenterOwner" Icon="/Assets/icon.ico">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Configurações do orçamento" Style="{StaticResource Title}"/><TextBlock Text="Todos os valores podem ser alterados. As mudanças valem para os dois computadores e entram no backup." Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel>
  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="RulesGrid" IsReadOnly="False" SelectionMode="Single" CanUserAddRows="False" RowHeight="48">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Produto" Binding="{Binding Product}" Width="2.3*"/>
    <DataGridTextColumn Header="R$/m²" Binding="{Binding SquareMeterRate}" Width=".8*"/>
    <DataGridTextColumn Header="Custo mínimo" Binding="{Binding MinimumCost}" Width="1*"/>
    <DataGridTextColumn Header="Multiplicador" Binding="{Binding MarkupMultiplier}" Width="1*"/>
    <DataGridTextColumn Header="Frete retirada" Binding="{Binding NoArtworkFee}" Width="1*"/>
    <DataGridTextColumn Header="Arte (sempre)" Binding="{Binding ArtworkFee}" Width="1*"/>
   </DataGrid.Columns>
  </DataGrid></Border>
  <Grid Grid.Row="3" Margin="0,16,0,0"><StackPanel Orientation="Horizontal"><Button Content="Adicionar produto" Style="{StaticResource SoftButton}" Margin="0,0,8,0" Click="Add_Click"/><Button Content="Remover" Style="{StaticResource DangerCompactButton}" Click="Remove_Click"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Style="{StaticResource SoftButton}" Margin="0,0,8,0" Click="Cancel_Click"/><Button Content="Salvar" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></StackPanel></Grid>
 </Grid>
</Window>
