<Window x:Class="GraficaCaixa.Wpf.BudgetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GraficaCaixa.Wpf" Title="Orçamentos" Width="1320" Height="860" MinWidth="1050" MinHeight="720" WindowStartupLocation="CenterOwner" WindowState="Maximized" Icon="/Assets/icon.ico">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock Text="Orçamentos" Style="{StaticResource Title}"/><TextBlock Text="Calcule por medida ou consulte os prazos de produção." Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="PDF de prévia" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="PreviewPdf_Click" ToolTip="Gera o PDF para enviar ao cliente, já com este cálculo (Ctrl+P)"/><Button x:Name="ProspectsButton" Content="Em acompanhamento" Style="{StaticResource SoftButton}" Margin="0,0,8,0" Click="Prospects_Click" ToolTip="Orçamentos enviados: cobrar o retorno e marcar se virou pedido"/><Button Content="Calculadora" Style="{StaticResource SoftButton}" Margin="0,0,8,0" Click="Calculator_Click" ToolTip="Aproveitamento em folha A4, adesivo m² e área fixa"/><Button Content="Fechar" Style="{StaticResource SoftButton}" Click="Close_Click"/></StackPanel></Grid>
  <TabControl Grid.Row="2">
   <TabItem Header="Calculadora prática"><ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <Grid Margin="0,18,6,12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}"><StackPanel>
      <Grid><TextBlock Text="Dados do serviço" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/><Button Content="Configurações" Style="{StaticResource SoftButton}" HorizontalAlignment="Right" Click="Settings_Click" ToolTip="Preço por m², mínimo, frete e arte de cada produto"/></Grid>
      <TextBlock Text="Produto" Style="{StaticResource FieldLabel}" Margin="0,15,0,6"/><ComboBox x:Name="ProductBox" DisplayMemberPath="Product" SelectionChanged="Input_Changed"/>
      <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="WidthLabel" Text="Largura (m)" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/><TextBox x:Name="WidthBox" Text="0,90" TextChanged="Input_Changed"/></StackPanel><StackPanel Grid.Column="2"><TextBlock x:Name="HeightLabel" Text="Altura (m)" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/><TextBox x:Name="HeightBox" Text="1,20" TextChanged="Input_Changed"/></StackPanel></Grid>
      <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Unidade das medidas" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/><ComboBox x:Name="UnitBox" SelectedIndex="0" SelectionChanged="Input_Changed"><ComboBoxItem Content="Metros"/><ComboBoxItem Content="Centímetros"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Quantidade" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/><TextBox x:Name="QuantityBox" Text="1" TextChanged="Input_Changed"/></StackPanel></Grid>
      <TextBlock Text="Adicional de arte sempre incluído, mesmo com arte pronta." TextWrapping="Wrap" Foreground="{DynamicResource Accent}" Margin="0,14,0,0"/>
      <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="10" Padding="14" Margin="0,20,0,0"><StackPanel><TextBlock Text="Como o valor é calculado" FontWeight="SemiBold"/><TextBlock x:Name="FormulaText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="18"/></StackPanel></Border>
     </StackPanel></Border>
     <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="Resultado" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/><TextBlock Text="Valor para orçar" Foreground="{DynamicResource Muted}" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="RecommendedText" Text="R$ 0,00" FontSize="38" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,4,0,14"/>
      <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="12" Padding="16,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Área" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="AreaText" Grid.Column="1" FontWeight="SemiBold"/></Grid></Border>
      <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="12" Padding="16,11" Margin="0,6,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Preço pelo tamanho" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="SizePriceText" Grid.Column="1" FontWeight="SemiBold"/></Grid></Border>
      <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="12" Padding="16,11" Margin="0,6,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Frete interno + arte" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="WithoutArtworkText" Grid.Column="1" FontWeight="SemiBold"/></Grid></Border>
      <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="12" Padding="16,11" Margin="0,6,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Venda mínima oficial" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="WithArtworkText" Grid.Column="1" FontWeight="SemiBold"/></Grid></Border>
      <!-- Custo interno (só para quem pode alterar custos): não entra no PDF nem no "Copiar resumo"; "Criar pedido" leva este custo para o item. -->
      <Border x:Name="CostPanel" Background="{DynamicResource WarningSoft}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,12,0,0" Visibility="Collapsed"><StackPanel>
       <WrapPanel><TextBlock Text="Seu custo" FontWeight="SemiBold" Margin="0,0,8,0"/><Border Background="{DynamicResource Surface}" CornerRadius="9" Padding="8,1"><TextBlock Text="interno · não vai no PDF nem no resumo" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Warning}"/></Border></WrapPanel>
       <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CostSizeLabel" Text="Custo pelo tamanho" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,12,0"/><TextBlock x:Name="CostSizeText" Grid.Column="1" FontWeight="SemiBold"/></Grid>
       <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock  Text="Custo mínimo (saída mínima)" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,12,0"/><TextBlock x:Name="CostMinimumText" Grid.Column="1" FontWeight="SemiBold"/></Grid>
       <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center"><Run Text="Custo real"/><Run x:Name="CostRuleText" Foreground="{DynamicResource Muted}" FontSize="13"/></TextBlock><TextBlock x:Name="CostText" Grid.Column="1" FontSize="18" FontWeight="SemiBold"/></Grid></Border>
       <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center"><Run Text="Ganho estimado"/><Run x:Name="GainHintText" Foreground="{DynamicResource Muted}" FontSize="13"/></TextBlock><TextBlock x:Name="GainText" Grid.Column="1" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource COk}"/></Grid>
      </StackPanel></Border>
      <TextBlock x:Name="ValidationText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,8,0,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="Copiar resumo" Style="{StaticResource SoftButton}" Margin="0,0,8,0" Click="Copy_Click" ToolTip="Texto pronto para o WhatsApp (Ctrl+Shift+C)"/><Button x:Name="SaveProspectButton" Content="Guardar para acompanhar" Style="{StaticResource SoftButton}" Margin="0,0,8,0" Click="SaveProspect_Click" ToolTip="Guarda este orçamento para lembrar de cobrar o retorno do cliente"/><Button Content="Criar pedido" Style="{StaticResource PrimaryButton}" Click="CreateOrder_Click" ToolTip="Abre um pedido com este produto, medidas e valor (Ctrl+Enter)"/></StackPanel>
     </StackPanel></Border>
    </Grid></ScrollViewer>
   </TabItem>
   <TabItem Header="Prazos de produção"><local:ProductionDeadlinesView x:Name="Deadlines" Margin="0,18,0,0"/></TabItem>
  </TabControl>
 </Grid>
</Window>
