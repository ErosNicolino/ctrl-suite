<Window x:Class="GraficaCaixa.Wpf.ConnectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Conectar outro computador" Width="730" Height="620" MinWidth="620" MinHeight="520" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner" Icon="/Assets/icon.ico">
 <Grid Margin="30"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,0,14"><TextBlock Text="Conectar outro computador" Style="{StaticResource Title}"/><TextBlock Text="No outro PC, escolha Conectar ao principal e cole este código de uso único, válido por 10 minutos. Depois, entre com seu usuário e senha. O serviço do PC1 deve permanecer ligado." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,12,0,20"/><TextBlock x:Name="AddressText" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap"/><TextBlock Text="Base de dados usada neste computador principal:" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="DataPathText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,12"/><TextBlock Text="Código de conexão" Style="{StaticResource FieldLabel}"/><Border CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource SurfaceAlt}" Padding="16,14"><DockPanel><TextBlock x:Name="CountdownText" DockPanel.Dock="Right" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><TextBlock Text="••••••••••••••••••••••••" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/></DockPanel></Border><PasswordBox x:Name="CodeBox" Visibility="Collapsed"/><TextBlock Text="O código fica oculto na tela. Use o botão abaixo para copiar e cole no outro computador." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0"/><TextBlock Text="Este código autoriza somente o pareamento. Ele não é uma sessão de usuário e pode ser revogado em Sessões e dispositivos." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,14,0,0"/></StackPanel></ScrollViewer>
  <Button x:Name="CopyButton" Grid.Row="1" Content="Copiar código de conexão" ToolTip="Copia o código; ele continua oculto aqui" Style="{StaticResource PrimaryButton}" Click="Copy_Click"/>
 </Grid>
</Window>
