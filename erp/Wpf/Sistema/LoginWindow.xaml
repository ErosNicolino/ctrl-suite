<Window x:Class="GraficaCaixa.Wpf.LoginWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:GraficaCaixa.Wpf" Title="Ctrl A Ctrl P • Acesso" Width="820" Height="760" MinWidth="680" MinHeight="620"
 WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" Icon="/Assets/icon.ico"
 Background="{DynamicResource SurfaceAlt}">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <Grid MinHeight="720">
   <Grid.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
     <GradientStop Color="{DynamicResource AccentSoftColor}" Offset="0"/>
     <GradientStop Color="{DynamicResource PaperColor}" Offset=".55"/>
     <GradientStop Color="{DynamicResource SurfaceAltColor}" Offset="1"/>
    </LinearGradientBrush>
   </Grid.Background>
   <Ellipse Width="330" Height="330" Fill="{DynamicResource Accent}" Opacity=".10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-150,-170,0,0"/>
   <Ellipse Width="270" Height="270" Fill="{DynamicResource CViolet}" Opacity=".08" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-120,-140"/>
   <Border x:Name="CardBox" Width="570" Padding="46,30,46,30" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
           BorderThickness="1" CornerRadius="22" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity=".12" Color="#46505A"/></Border.Effect>
    <StackPanel HorizontalAlignment="Center" Width="478">
     <Image Source="{DynamicResource Logo}" Height="92" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,16"/>
     <TextBlock Text="Bem-vindo" FontSize="30" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center"/>
     <TextBlock Text="Entre para acessar vendas, pedidos e produção"
                Foreground="{DynamicResource Muted}" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,6,0,22"/>
     <StackPanel Width="440" HorizontalAlignment="Center">
      <TextBlock Text="Usuário" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
      <TextBox x:Name="UserBox" Text="Gráfica" Margin="0,0,0,16" TextChanged="Field_Changed"/>
      <TextBlock Text="Senha" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
      <Grid>
       <PasswordBox x:Name="PasswordBox" PasswordChanged="Field_Changed" PreviewKeyDown="Password_KeyDown" GotKeyboardFocus="Password_KeyDown" Padding="12,0,44,0"/>
       <TextBox x:Name="PlainBox" Visibility="Collapsed" TextChanged="Plain_Changed" Padding="12,0,44,0"/>
       <ToggleButton x:Name="ShowPassword" HorizontalAlignment="Right" VerticalAlignment="Center" Width="40" Height="38" Margin="0,0,2,0" Focusable="False" Cursor="Hand" ToolTip="Mostrar ou ocultar a senha" Click="ShowPassword_Click" Background="Transparent" BorderThickness="0"><local:UiIcon x:Name="EyeIcon" IconName="eye" Width="18" Height="18" Foreground="{DynamicResource Muted}"/></ToggleButton>
      </Grid>
      <StackPanel x:Name="CapsWarning" Orientation="Horizontal" Visibility="Collapsed" Margin="0,7,0,0"><local:UiIcon IconName="triangle-alert" Width="15" Height="15" Foreground="{DynamicResource Warning}" Margin="0,0,6,0"/><TextBlock Text="Caps Lock está ligado" Foreground="{DynamicResource Warning}" FontSize="12.5" FontWeight="SemiBold"/></StackPanel>
      <Border x:Name="ErrorBox" Style="{StaticResource Note}" Background="{DynamicResource DangerSoft}" TextElement.Foreground="{DynamicResource Danger}" Visibility="Collapsed" Margin="0,14,0,0"><StackPanel Orientation="Horizontal"><local:UiIcon IconName="circle-alert" Width="16" Height="16" Margin="0,1,8,0" VerticalAlignment="Top" Foreground="{DynamicResource Danger}"/><TextBlock x:Name="ErrorText" TextWrapping="Wrap" Width="390" FontWeight="SemiBold"/></StackPanel></Border>
      <Button x:Name="LoginButton" Content="Entrar no sistema" Style="{StaticResource PrimaryButton}" Height="46" Margin="0,20,0,0" Click="Login_Click" IsDefault="True" ToolTip="Enter"/>
<TextBlock Text="Esqueceu a senha? Peça ao administrador para redefinir em Sistema › Usuários e permissões." Style="{StaticResource Hint}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
      <Expander x:Name="SetupExpander" Margin="0,16,0,0" HorizontalContentAlignment="Stretch" ToolTip="Modo de uso, pasta dos dados e conexão com o computador principal">
       <Expander.Header>
        <TextBlock Text="Configuração deste computador" Foreground="{DynamicResource Muted}" FontSize="12.5" VerticalAlignment="Center"/>
       </Expander.Header>
       <Border Style="{StaticResource Card}" Background="{DynamicResource SurfaceAlt}" Padding="16,14" Margin="0,12,0,0">
       <StackPanel>
        <TextBlock Text="Modo de uso" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="ModeBox" SelectionChanged="Mode_Changed" Margin="0,0,0,12"/>
        <StackPanel x:Name="DataPanel">
         <TextBlock Text="Pasta dos dados" Style="{StaticResource FieldLabel}"/>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="FolderBox"/>
          <Button x:Name="ChooseDataButton" Grid.Column="1" Content="Escolher" Style="{StaticResource SoftButton}" Margin="8,0,0,0" Click="Choose_Click" ToolTip="Escolher a pasta onde ficam os dados deste computador"/>
         </Grid>
         <Button x:Name="PrepareButton" Content="Preparar dados locais" Style="{StaticResource SoftButton}" HorizontalAlignment="Left" Click="Prepare_Click" Margin="0,8,0,0" ToolTip="Usar um banco recuperado e validado neste computador principal"/>
         <TextBlock Text="No modo principal, o banco fica neste computador e os demais se conectam a ele." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,12"/>
        </StackPanel>
        <StackPanel x:Name="ConnectionPanel">
         <TextBlock Text="Código de conexão do computador principal" Style="{StaticResource FieldLabel}"/>
         <PasswordBox x:Name="ConnectionBox" ToolTip="Cole o código completo fornecido pelo computador principal. Ele fica sempre oculto."/>
         <TextBlock Text="O código fica oculto por segurança. Cole com Ctrl+V." Style="{StaticResource Hint}" Margin="0,6,0,12"/>
        </StackPanel>
        <TextBox x:Name="ReportsFolderBox" Visibility="Collapsed"/>
        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" ToolTip="Os documentos usam a pasta compartilhada definida em Sistema › Geral e arquivos."><Run Text="Pasta antiga de relatórios (só referência): "/><Run Text="{Binding Text,ElementName=ReportsFolderBox,Mode=OneWay}"/></TextBlock>
       </StackPanel>
       </Border>
      </Expander>
     </StackPanel>
     <TextBlock Text="CTRL A CTRL P  •  Gestão da gráfica" Foreground="{DynamicResource Muted}" FontSize="11"
                TextAlignment="Center" HorizontalAlignment="Center" Margin="0,24,0,0"/>
    </StackPanel>
   </Border>
  </Grid>
 </ScrollViewer>
</Window>
