<Window x:Class="GraficaCaixa.Wpf.AuditBackupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Histórico e backups" Width="1100" Height="700" MinWidth="900" MinHeight="580" WindowStartupLocation="CenterOwner" Icon="/Assets/icon.ico">
 <Grid Margin="34,26,34,32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="Histórico e recuperação" Style="{StaticResource Title}"/><TextBlock Text="Consulte alterações e restaure versões anteriores dos dados" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel>
  <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
   <TabItem Header="Histórico de alterações"><Border Style="{StaticResource Card}" Padding="0" Margin="0,14,0,0"><DataGrid x:Name="AuditGrid"><DataGrid.Columns><DataGridTextColumn Header="Data e horário" Binding="{Binding Date}" Width="1.2*"/><DataGridTextColumn Header="Ação" Binding="{Binding Action}" Width="1.4*" ElementStyle="{StaticResource TrimCell}"/><DataGridTextColumn Header="Detalhes" Binding="{Binding Description}" Width="3*" ElementStyle="{StaticResource TrimCell}"/><DataGridTextColumn Header="Usuário" Binding="{Binding User}" Width="1.1*" ElementStyle="{StaticResource TrimCell}"/><DataGridTextColumn Header="Computador" Binding="{Binding Computer}" Width=".9*" ElementStyle="{StaticResource TrimCell}"/></DataGrid.Columns></DataGrid></Border></TabItem>
   <TabItem Header="Backups"><Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <Border Background="{DynamicResource AccentSoft}" CornerRadius="12" Padding="16" Margin="0,0,0,14"><Grid><TextBlock x:Name="BackupKeepText" Text="O sistema mantém as últimas 30 versões. Ao restaurar, o estado atual também é salvo como backup." Foreground="{DynamicResource Accent}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,160,0"/><Button Content="Restaurar selecionado" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="Restore_Click"/></Grid></Border>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="BackupGrid"><DataGrid.Columns><DataGridTextColumn Header="Data e horário" Binding="{Binding Date}" Width="1.4*"/><DataGridTextColumn Header="Arquivo" Binding="{Binding FileName}" Width="2.5*" ElementStyle="{StaticResource TrimCell}"/><DataGridTextColumn Header="Tamanho" Binding="{Binding Size}" Width="1*" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/></DataGrid.Columns></DataGrid></Border>
   </Grid></TabItem>
  </TabControl>
 </Grid>
</Window>
