<Window x:Class="GraficaCaixa.Wpf.ComponentCatalogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GraficaCaixa.Wpf" Title="Catálogo de componentes" Width="1200" Height="820" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterOwner" Icon="/Assets/icon.ico">
 <!-- Tela interna (Administrador): mostra o conjunto de componentes UX 2.0 para conferência visual em claro/escuro. -->
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,14"><Grid><StackPanel><TextBlock Text="SISTEMA" Style="{StaticResource Eyebrow}" Margin="0,0,0,2"/><TextBlock Text="Catálogo de componentes" Style="{StaticResource Title}"/><TextBlock Text="Base visual do redesenho (pacote 1). Use os botões para conferir tema, cores e movimento." Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="Claro / Escuro" Style="{StaticResource SoftButton}" Click="Theme_Click" Margin="0,0,8,0"/><Button Content="Viva / Sóbria" Style="{StaticResource SoftButton}" Click="Palette_Click" Margin="0,0,8,0"/><Button Content="Movimento" Style="{StaticResource SoftButton}" Click="Motion_Click"/></StackPanel></Grid></Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Body" Margin="24,18,24,40">

   <TextBlock Text="Logotipo (vetor; troca com o tema)" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
   <StackPanel Orientation="Horizontal" Margin="0,0,0,22"><Border Style="{StaticResource Panel}" Padding="18" Margin="0,0,12,0"><Image Source="{DynamicResource Logo}" Height="72" Stretch="Uniform"/></Border><Border Style="{StaticResource Panel}" Padding="10" Margin="0,0,12,0"><Image Source="{DynamicResource Logo}" Height="32" Stretch="Uniform"/></Border><Border Style="{StaticResource Panel}" Padding="8"><Image Source="{DynamicResource Logo}" Height="18" Stretch="Uniform"/></Border></StackPanel>

   <TextBlock Text="Cores (tabela única do ThemeManager)" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
   <WrapPanel x:Name="Swatches" Margin="0,0,0,22"/>

   <TextBlock Text="Tipografia" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
   <Border Style="{StaticResource Panel}" Padding="18" Margin="0,0,0,22"><StackPanel><TextBlock Text="EYEBROW · RÓTULO DE GRUPO" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/><TextBlock Text="Título da página (26)" Style="{StaticResource Title}"/><TextBlock Text="Título de seção (17)" Style="{StaticResource SectionTitle}" Margin="0,6,0,0"/><TextBlock Text="Texto do corpo (14) — números tabulares: R$ 1.234,56" Margin="0,6,0,0"/><TextBlock Text="Dica e texto secundário (12,5)" Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel></Border>

   <TextBlock Text="Botões" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
   <WrapPanel Margin="0,0,0,22"><Button Content="Salvar" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/><Button Content="＋ Novo pedido" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/><Button Content="Editar" Style="{StaticResource SoftButton}" Margin="0,0,8,8"/><Button Content="Copiar resumo" Style="{StaticResource SoftButton}" Margin="0,0,8,8"/><Button Content="Cancelar" Style="{StaticResource GhostButton}" Margin="0,0,8,8"/><Button Content="Excluir" Style="{StaticResource DangerCompactButton}" Margin="0,0,8,8"/><Button Content="Confirmar exclusão" Style="{StaticResource DangerButton}" Margin="0,0,8,8"/><Button Content="Atualizar" Style="{StaticResource SmallButton}" Margin="0,0,8,8"/><Button Content="Salvar" Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="0,0,8,8"/><Button Style="{StaticResource IconButton}" Tag="pencil" ToolTip="Editar" Margin="0,0,8,8"/><Button Style="{StaticResource IconButton}" Tag="trash" ToolTip="Excluir" Margin="0,0,8,8"/><Button Content="Ações ▾" Style="{StaticResource SoftButton}" Margin="0,0,8,8"/></WrapPanel>

   <TextBlock Text="Campos" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
   <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Cliente" Style="{StaticResource FieldLabel}"/><TextBox Tag="Nome do cliente"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Telefone" Style="{StaticResource FieldLabel}"/><TextBox Text="(11) 9" local:Ui.HasError="True"/><TextBlock Text="Informe o telefone com DDD." Style="{StaticResource FieldError}"/></StackPanel>
    <StackPanel Grid.Column="4"><TextBlock Text="Forma de pagamento" Style="{StaticResource FieldLabel}"/><ComboBox SelectedIndex="0"><ComboBoxItem Content="PIX"/><ComboBoxItem Content="Dinheiro"/><ComboBoxItem Content="Cartão de crédito"/></ComboBox></StackPanel>
    <StackPanel Grid.Column="6"><TextBlock Text="Data" Style="{StaticResource FieldLabel}"/><DatePicker/></StackPanel>
   </Grid>
   <WrapPanel Margin="0,0,0,22"><CheckBox Content="Caixa de seleção" IsChecked="True" Margin="0,0,24,8"/><CheckBox Content="Interruptor" Style="{StaticResource Switch}" IsChecked="True" Margin="0,0,24,8"/><CheckBox Content="Interruptor desligado" Style="{StaticResource Switch}" Margin="0,0,24,8"/></WrapPanel>

   <TextBlock Text="Chips, segmentado e Lista ⇄ Cards" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
   <WrapPanel Margin="0,0,0,22" VerticalAlignment="Center"><ToggleButton Content="Este mês" Style="{StaticResource Chip}" IsChecked="True"/><ToggleButton Content="PIX" Style="{StaticResource Chip}"/><ToggleButton Content="Caixa aberto" Style="{StaticResource Chip}"/>
    <Border Style="{StaticResource SegmentBar}" Margin="12,0,12,6"><StackPanel Orientation="Horizontal"><RadioButton Content="Em andamento" Style="{StaticResource Segment}" GroupName="seg" IsChecked="True"/><RadioButton Content="Falta pagamento" Style="{StaticResource Segment}" GroupName="seg"/><RadioButton Content="Concluídos" Style="{StaticResource Segment}" GroupName="seg"/></StackPanel></Border>
    <local:ViewToggle Margin="0,0,0,6"/></WrapPanel>

   <TextBlock Text="Etiquetas de estado (ícone + texto, nunca só cor)" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
   <WrapPanel Margin="0,0,0,22"><local:StatusTag Tone="late" Text="Atrasado" Margin="0,0,8,0"/><local:StatusTag Tone="now" Text="Vence hoje" Margin="0,0,8,0"/><local:StatusTag Tone="ready" Text="Pronto" Margin="0,0,8,0"/><local:StatusTag Tone="ok" Text="No prazo" Margin="0,0,8,0"/><local:StatusTag Tone="neutral" Text="Aguarda arte" Margin="0,0,8,0"/></WrapPanel>

   <TextBlock Text="Indicadores (KPI)" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
   <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <local:KpiCard x:Name="HeroKpi" Label="Recebido hoje" Value="R$ 909,00" Hint="PIX R$ 567,30 · Crédito R$ 210,00" Tone="ok" IsHero="True"/><local:KpiCard Grid.Column="2" Label="Dinheiro esperado" Value="R$ 155,00" Tone="info"/><local:KpiCard Grid.Column="4" Label="Pedidos que pedem atenção" Value="4" Hint="2 atrasados" Tone="danger"/><local:KpiCard Grid.Column="6" Label="Carregando…" IsLoading="True" Tone="warn"/>
   </Grid>

   <TextBlock Text="WhatsApp" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
   <WrapPanel Margin="0,0,0,22"><local:WhatsAppButton Phone="(11) 99999-0000" OpenOnClick="False" Margin="0,0,10,0"/><local:WhatsAppButton Phone="(11) 99999-0000" Compact="True" OpenOnClick="False" Margin="0,0,10,0"/><local:WhatsAppButton Phone="7390" OpenOnClick="False" Margin="0,0,10,0"/></WrapPanel>

   <TextBlock Text="Avisos (toast) e estado vazio" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
   <WrapPanel Margin="0,0,0,10"><Button Content="Mostrar aviso" Style="{StaticResource SoftButton}" Click="Toast_Click" Margin="0,0,8,8"/><Button Content="Aviso com Desfazer" Style="{StaticResource SoftButton}" Click="ToastUndo_Click" Margin="0,0,8,8"/><Button Content="Abrir diálogo central (exemplo)" Style="{StaticResource PrimaryButton}" Click="Dialog_Click" Margin="0,0,8,8"/></WrapPanel>
   <Border Style="{StaticResource Panel}" Margin="0,0,0,22"><local:EmptyState Title="Nenhum pedido com esse filtro" Hint="Tente outro nome, número ou etapa." ActionText="Limpar filtros" IconName="inbox"/></Border>

   <TextBlock Text="Seções do diálogo e resumo" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
   <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
    <StackPanel><local:SectionCard Number="1" Header="Cliente" Hint="quem está comprando" IsDone="True"><TextBox Text="Cliente Exemplo"/></local:SectionCard><local:SectionCard Number="2" Header="Itens" Hint="o que vai produzir"><TextBox Tag="Produto ou serviço"/></local:SectionCard><local:SectionCard Header="Custo (opcional)" IsOptional="True"><TextBlock Text="Vazio = pendente nos relatórios, nunca zero." Style="{StaticResource Hint}"/></local:SectionCard></StackPanel>
    <Border Grid.Column="2" Style="{StaticResource SummaryCard}" VerticalAlignment="Top"><StackPanel><TextBlock Text="TOTAL DO PEDIDO" Style="{StaticResource Eyebrow}" Margin="0"/><TextBlock Text="R$ 120,00" Style="{StaticResource SummaryValue}"/><Separator/><DockPanel><TextBlock Text="Recebido" DockPanel.Dock="Left"/><TextBlock Text="R$ 60,00" FontWeight="SemiBold" HorizontalAlignment="Right"/></DockPanel><DockPanel Margin="0,6,0,0"><TextBlock Text="Saldo" DockPanel.Dock="Left"/><TextBlock Text="R$ 60,00" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource Danger}"/></DockPanel></StackPanel></Border>
   </Grid>

   <TextBlock Text="Avisos em linha" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
   <StackPanel Margin="0,0,0,22"><Border Style="{StaticResource Note}" Margin="0,0,0,8"><TextBlock Text="38 pedidos sem custo: o resultado é PARCIAL." TextWrapping="Wrap"/></Border><Border Style="{StaticResource NoteCalm}"><TextBlock Text="Retificação disponível com justificativa." TextWrapping="Wrap"/></Border></StackPanel>

   <TextBlock Text="Tabela" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
   <Border Style="{StaticResource Panel}" Padding="0" Margin="0,0,0,22" Height="200"><DataGrid x:Name="SampleGrid" CanUserSortColumns="True"><DataGrid.Columns><DataGridTextColumn Header="Hora" Binding="{Binding Hora}" Width="80"/><DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="*"/><DataGridTextColumn Header="Pagamento" Binding="{Binding Pagamento}" Width="140"/><DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="110"/></DataGrid.Columns></DataGrid></Border>

   <TextBlock Text="Abas" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
   <TabControl Height="90" Margin="0,0,0,22"><TabItem Header="Visão financeira"><TextBlock Text="Conteúdo da aba" Style="{StaticResource Hint}"/></TabItem><TabItem Header="Gráficos"/><TabItem Header="Sangrias"/><TabItem Header="Cancelados"/></TabControl>

   <TextBlock Text="Ícones (Lucide, ISC/MIT — Assets\lucide-license.txt)" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
   <WrapPanel x:Name="Icons"/>
  </StackPanel></ScrollViewer>
 </Grid>
</Window>
