<Window x:Class="GraficaCaixa.Wpf.UsersWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GraficaCaixa.Wpf" Title="Usuários e Permissões" Width="1050" Height="690" MinWidth="850" MinHeight="560" WindowStartupLocation="CenterOwner">
 <Grid Margin="34,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,24"><StackPanel><TextBlock Text="SISTEMA  /  ACESSO" Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Usuários e permissões" Style="{StaticResource Title}" Margin="0,7,0,6"/><TextBlock Text="Um perfil base. Exceções apenas quando necessário." Foreground="{DynamicResource Muted}"/></StackPanel><Button Content="+ Novo usuário" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="New_Click"/></Grid>
  <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" Tag="Pesquisar nome ou login…" TextChanged="FilterChanged"/><ComboBox x:Name="StatusBox" Grid.Column="1" Margin="12,0" SelectionChanged="FilterChanged"><ComboBoxItem Content="Ativos" IsSelected="True"/><ComboBoxItem Content="Inativos"/><ComboBoxItem Content="Todos"/></ComboBox><Button Grid.Column="2" Content="Perfis base" Style="{StaticResource SoftButton}" Click="Profiles_Click"/></Grid>
  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><Grid><DataGrid x:Name="UsersGrid" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" RowHeight="62" SelectionChanged="SelectionChanged" MouseDoubleClick="Edit_Click"><DataGrid.Columns><DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Login" Binding="{Binding Login}" Width="1.3*"/><DataGridTextColumn Header="Perfil base" Binding="{Binding Role}" Width="1.2*"/><DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:StatusTag Text="{Binding Status}" Tone="{Binding Status,Converter={x:Static local:StatusTone.Instance}}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Último acesso" Binding="{Binding LastAccess}" Width="150"/></DataGrid.Columns></DataGrid><TextBlock x:Name="EmptyState" Text="Nenhum usuário encontrado" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" IsHitTestVisible="False"/></Grid></Border>
  <StackPanel Grid.Row="3" Margin="0,20,0,0"><WrapPanel x:Name="Actions"><Button Content="Editar" Style="{StaticResource SoftButton}" Click="Edit_Click"/><Button Content="Permissões" Style="{StaticResource PrimaryButton}" Margin="8,0" Click="Permissions_Click"/><Button x:Name="ToggleButton" Content="Desativar" Style="{StaticResource SoftButton}" Click="Toggle_Click"/><Button Content="Redefinir senha" Style="{StaticResource SoftButton}" Margin="8,0" Click="Reset_Click"/><Button Content="Encerrar sessões" Style="{StaticResource SoftButton}" Click="Revoke_Click"/></WrapPanel><TextBlock x:Name="Feedback" Text="Desative usuários que saíram. O histórico permanece identificado." Foreground="{DynamicResource Muted}" Margin="0,14,0,0" TextWrapping="Wrap"/></StackPanel>
 </Grid>
</Window>
