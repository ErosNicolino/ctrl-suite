<Window x:Class="GraficaCaixa.Wpf.FollowUpWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GraficaCaixa.Wpf" Title="Acompanhamento" Width="1180" Height="760" MinWidth="1000" MinHeight="640" WindowStartupLocation="CenterOwner">
 <Grid x:Name="PageRoot" Margin="26,22,26,18" SizeChanged="PageRoot_SizeChanged"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><Button DockPanel.Dock="Right" x:Name="AddButton" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top" Click="Add_Click"/><StackPanel x:Name="DebtTabs" DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Top" Visibility="Collapsed"><Button x:Name="PendingTab" Content="Em cobrança" Style="{StaticResource SoftButton}" Click="PendingTab_Click"/><Button x:Name="LossTab" Content="Perdas" Style="{StaticResource SoftButton}" Margin="8,0,0,0" Click="LossTab_Click"/></StackPanel><StackPanel><TextBlock x:Name="Heading" Style="{StaticResource Title}"/><TextBlock x:Name="Subtitle" Foreground="{DynamicResource Muted}" Margin="0,4,0,12"/></StackPanel></DockPanel>
  <StackPanel Grid.Row="1" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
   <Grid x:Name="SummaryTile"><Border Style="{StaticResource KpiCap}" Background="{DynamicResource CDanger}"/><Border Style="{StaticResource KpiCapTile}"><StackPanel><TextBlock x:Name="Summary" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource Ink}"/><TextBlock x:Name="SummaryHint" Foreground="{DynamicResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border></Grid>
   <UniformGrid x:Name="BandsPanel" Grid.Column="2" Columns="3" Visibility="Collapsed"/></Grid></StackPanel>
  <StackPanel Grid.Row="2" Margin="0,0,0,0"><WrapPanel><ComboBox x:Name="FilterBox" Width="128" Margin="0,0,8,10" SelectionChanged="Filter_Changed" ToolTip="Pendentes, quitados, todos ou só os com mais de 30 dias"/><WrapPanel x:Name="CollectionFilters" Margin="0,0,0,10" Visibility="Collapsed"><ComboBox x:Name="CollectionStatusFilter" Width="166" Margin="0,0,8,0" SelectionChanged="Filter_Changed" ToolTip="Situação da cobrança (último contato registrado)"/><ComboBox x:Name="OrderFilter" Width="132" SelectionChanged="Filter_Changed" ToolTip="Ordem da lista"/></WrapPanel><TextBox x:Name="SearchBox" Width="184" Margin="8,0,12,10" local:SearchShortcut.IsTarget="True" ToolTip="Pesquisar cliente, contato ou serviço" Tag="Pesquisar cliente, contato ou serviço…" TextChanged="Filter_Changed"/><StackPanel x:Name="OriginFilters" Orientation="Horizontal" Margin="0,0,0,10" Visibility="Collapsed"><TextBlock x:Name="OriginFromLabel" Text="Origem" VerticalAlignment="Center"/><DatePicker x:Name="FromDate" Width="108" Margin="6,0" SelectedDateChanged="Filter_Changed"/><TextBlock Text="até" VerticalAlignment="Center"/><DatePicker x:Name="ToDate" Width="108" Margin="6,0,0,0" SelectedDateChanged="Filter_Changed"/></StackPanel></WrapPanel><TextBlock x:Name="CustomerBalanceText" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/></StackPanel>
  <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8" MinHeight="170"><Grid><DataGrid x:Name="Entries" MouseDoubleClick="Edit_Click" SelectionChanged="Selection_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><!-- Toda linha reserva a faixa (transparente): só as de mais de 1 ano a pintam, sem desalinhar as colunas. --><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="4,0,0,0"/><Style.Triggers><DataTrigger Binding="{Binding OverYear}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Danger}"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle><DataGrid.Columns>
   <DataGridTextColumn Header="Cliente" Binding="{Binding Customer}" Width="1.1*" MinWidth="140"/>
   <DataGridTextColumn Header="Telefone" Binding="{Binding Contact}" Width="130"/>
   <DataGridTextColumn Header="Serviço / referência" Binding="{Binding Description}" Width="1.5*" MinWidth="150"/>
   <DataGridTextColumn x:Name="FinancialStatusColumn" Header="Situação" Binding="{Binding Status}" Width="180"/>
   <DataGridTextColumn x:Name="AmountColumn" Header="Valor" Binding="{Binding AmountText}" Width="110" Visibility="Collapsed" ElementStyle="{StaticResource MoneyCell}" HeaderStyle="{StaticResource MoneyHeader}"/><DataGridTextColumn x:Name="BalanceColumn" Header="Saldo / retorno" Binding="{Binding Detail}" Width="128"/>
   <DataGridTextColumn x:Name="CollectionColumn" Header="Cobrança" Binding="{Binding CollectionStatus}" Width="166" Visibility="Collapsed"/>
   <DataGridTextColumn x:Name="LossDateColumn" Header="Data da perda" Binding="{Binding LossDate}" Width="110" Visibility="Collapsed"/><DataGridTextColumn x:Name="LossReasonColumn" Header="Motivo / observação" Binding="{Binding LossNotes}" Width="1.3*" Visibility="Collapsed"/><DataGridTemplateColumn x:Name="AgeColumn" Header="Idade" SortMemberPath="Sort" Width="112" Visibility="Collapsed"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="Tag" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="9" Padding="8,2" Background="{DynamicResource InfoSoft}" ToolTip="{Binding Age}"><TextBlock x:Name="TagText" Text="{Binding AgeShort}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Info}"/></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding AgeTone}" Value="warn"><Setter TargetName="Tag" Property="Background" Value="{DynamicResource WarningSoft}"/><Setter TargetName="TagText" Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger><DataTrigger Binding="{Binding AgeTone}" Value="danger"><Setter TargetName="Tag" Property="Background" Value="{DynamicResource DangerSoft}"/><Setter TargetName="TagText" Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger><DataTrigger Binding="{Binding AgeTone}" Value="neutral"><Setter TargetName="Tag" Property="Background" Value="{DynamicResource SurfaceAlt}"/><Setter TargetName="TagText" Property="Foreground" Value="{DynamicResource Muted}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
  </DataGrid.Columns></DataGrid><TextBlock x:Name="Empty" Text="Nenhum registro nesta lista" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="17" IsHitTestVisible="False"/></Grid></Border>
  <DockPanel Grid.Row="4" Margin="0,10,0,0"><WrapPanel><Button x:Name="EditButton" ToolTip="Ver ou editar a pendência selecionada (duplo clique)" Content="Ver / editar" Style="{StaticResource SoftButton}" Click="Edit_Click" Margin="0,0,8,0"/><Button x:Name="WhatsAppButton" Content="WhatsApp" ToolTip="Abrir a conversa no WhatsApp Desktop" Style="{StaticResource SoftButton}" Click="WhatsApp_Click" Margin="0,0,8,0"/><Button x:Name="ReceiveButton" Content="Registrar recebimento" ToolTip="Registrar pagamento recebido desta pendência" Style="{StaticResource PrimaryButton}" Click="Receive_Click" Margin="0,0,8,0"/><Button x:Name="ContactButton" Content="Registrar contato de hoje" Style="{StaticResource SoftButton}" Click="Contact_Click" Margin="0,0,8,0"/><Button x:Name="ConvertButton" Content="Transformar em pedido" Style="{StaticResource PrimaryButton}" Click="Convert_Click" Margin="0,0,8,0"/><Button x:Name="CollectionButton" Content="Cobrança / histórico" ToolTip="Ver e registrar contatos de cobrança" Visibility="Collapsed" Style="{StaticResource SoftButton}" Click="Collection_Click" Margin="0,0,8,0"/><Button x:Name="CopyCollectionButton" Content="Copiar cobrança" ToolTip="Copiar a mensagem de cobrança para colar no WhatsApp" Visibility="Collapsed" Style="{StaticResource SoftButton}" Click="CopyCollection_Click" Margin="0,0,8,0"/><Button x:Name="CollectionQueueButton" Content="Cobrar em sequência" ToolTip="Abre o WhatsApp de cada devedor da lista com a mensagem de cobrança pronta; você envia e o contato fica registrado" Visibility="Collapsed" Style="{StaticResource SoftButton}" Click="CollectionQueue_Click" Margin="0,0,8,0"/><Button x:Name="DeclareLossButton" Content="Declarar como perda" ToolTip="Tirar das pendências como perda (pede motivo; pode ser recuperada depois)" Visibility="Collapsed" Style="{StaticResource SoftButton}" Click="DeclareLoss_Click" Margin="0,0,8,0"/><Button x:Name="DeleteDebtButton" Content="Excluir dívida avulsa" Visibility="Collapsed" IsEnabled="False" Style="{StaticResource DangerCompactButton}" Click="DeleteDebt_Click" Margin="0,0,8,0" ToolTip="Exclui somente dívida avulsa sem recebimentos registrados."/><Button x:Name="LossHistoryButton" Content="Histórico" Style="{StaticResource SoftButton}" Visibility="Collapsed" IsEnabled="False" Click="LossHistory_Click" Margin="0,0,8,0"/><Button x:Name="RecoverLossButton" Content="Recuperar perda" Style="{StaticResource PrimaryButton}" Visibility="Collapsed" IsEnabled="False" Click="RecoverLoss_Click" Margin="0,0,8,0"/></WrapPanel></DockPanel>
 </Grid>
</Window>

